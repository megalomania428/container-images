+// Codex OAuth base models whose native reasoning ceiling is "max" (above xhigh).
+export const CODEX_MAX_EFFORT_MODELS: ReadonlySet<string> = new Set([
+  "gpt-6-astra",
+  "gpt-6-sol",
+  "gpt-6-luna",
+  "gpt-5.6-sol",
+  "gpt-5.6-terra",
+  "gpt-5.6-luna",
+]);
+
+/**
+ * True when the model (optionally prefixed with codex/ or cx/ and optionally carrying an
+ * effort suffix) is a Codex base model that accepts reasoning effort "max".
+ */
+export function supportsCodexMaxEffort(model: unknown): boolean {
+  if (typeof model !== "string") return false;
+  let base = model.trim().toLowerCase();
+  base = base.replace(/^(?:codex|cx)\//, "");
+  base = base.replace(/(?:-(?:none|low|medium|high|xhigh|max)|\(max\))$/, "");
+  return CODEX_MAX_EFFORT_MODELS.has(base);
+}
