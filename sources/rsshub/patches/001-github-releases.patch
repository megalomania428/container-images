+
+const assetFragment = `fragment GithubReleasesAsset on ReleaseAsset {
+    id
+    name
+    downloadUrl
+    size
+    contentType
+    updatedAt
+}`;
+
+const repositoryFragments = `fragment GithubReleasesRepository on Repository {
+    id
+    nameWithOwner
+    description
+    url
+    isFork
+    isArchived
+    isPrivate
+    releases(first: $perRepo, orderBy: { field: CREATED_AT, direction: DESC }) {
+        pageInfo {
+            hasNextPage
+            endCursor
+        }
+        nodes {
+            ...GithubReleasesRelease
+        }
+    }
+}
+fragment GithubReleasesRelease on Release {
+    id
+    databaseId
+    name
+    tagName
+    url
+    isDraft
+    isPrerelease
+    createdAt
+    publishedAt
+    updatedAt
+    description
+    descriptionHTML
+    releaseAssets(first: 100) {
+        pageInfo {
+            hasNextPage
+            endCursor
+        }
+        nodes {
+            ...GithubReleasesAsset
+        }
+    }
+}
+${assetFragment}`;
+
+/** Public repositories of one organization or user; user input travels only in variables. */
+export const ownerPageQuery = (mode: 'org' | 'user') => {
+    const field = mode === 'org' ? 'organization' : 'user';
+    const affiliation = mode === 'org' ? '' : ', ownerAffiliations: [OWNER]';
+    return `query GithubReleasesOwnerPage($login: String!, $after: String, $size: Int!, $perRepo: Int!) {
+    owner: ${field}(login: $login) {
+        repositories(first: $size, after: $after, privacy: PUBLIC${affiliation}, orderBy: { field: NAME, direction: ASC }) {
+            pageInfo {
+                hasNextPage
+                endCursor
+            }
+            edges {
+                cursor
+                node {
+                    ...GithubReleasesRepository
+                }
+            }
+        }
+    }
+    rateLimit {
+        cost
+        remaining
+        resetAt
+    }
+}
+${repositoryFragments}`;
+};
+
+/** Explicit repositories r0..rN with owners in $o0..$oN and names in $n0..$nN. */
+export const repositoriesQuery = (count: number) => {
+    const declarations: string[] = [];
+    const selections: string[] = [];
+    for (let index = 0; index < count; index++) {
+        declarations.push(`$o${index}: String!, $n${index}: String!`);
+        selections.push(`    r${index}: repository(owner: $o${index}, name: $n${index}) {
+        ...GithubReleasesRepository
+    }`);
+    }
+    return `query GithubReleasesRepositories($perRepo: Int!, ${declarations.join(', ')}) {
+${selections.join('\n')}
+    rateLimit {
+        cost
+        remaining
+        resetAt
+    }
+}
+${repositoryFragments}`;
+};
+
+export const assetsQuery = `query GithubReleasesAssets($id: ID!, $after: String) {
+    node(id: $id) {
+        ... on Release {
+            releaseAssets(first: 100, after: $after) {
+                pageInfo {
+                    hasNextPage
+                    endCursor
+                }
+                nodes {
+                    ...GithubReleasesAsset
+                }
+            }
+        }
+    }
+    rateLimit {
+        cost
+        remaining
+        resetAt
+    }
+}
+${assetFragment}`;
+
+export type RepositorySlot = {
+    /** The cursor of the repository edge in owner mode, null in repository mode. */
+    cursor: string | null;
+    repository: GitHubRepository | null;
+    /** Every requested field arrived without errors, every release object included. */
+    complete: boolean;
+    /** The repository does not exist or is not visible, a retry cannot change that. */
+    missing: boolean;
+};
+
+export type ParsedPage = {
+    slots: RepositorySlot[];
+    /** Whole release objects of the response that no error points at, the base of the next page size after RESOURCE_LIMITS_EXCEEDED. */
+    returnedReleases: number;
+    resourceLimited: boolean;
+    hasNextPage: boolean;
+    endCursor: string | null;
+    /** Errors that do not belong to a single repository. */
+    pageErrors: string[];
+    ownerMissing: boolean;
+};
+
+type RepositoryNode = z.output<typeof repositorySchema>;
+
+const describeGraphqlError = (error: GraphqlError) => `${error.type ?? 'ERROR'}: ${error.message ?? 'no message'}`;
+
+const toSlot = (cursor: string | null, node: RepositoryNode | null, failed: boolean): RepositorySlot => {
+    if (node === null) {
+        return { cursor, repository: null, complete: false, missing: false };
+    }
+    const objects = node.releases?.nodes ?? [];
+    const releases = objects.filter((release) => release !== null);
+    return {
+        cursor,
+        repository: { ...node, releases },
+        complete: !failed && node.releases !== null && releases.length === objects.length,
+        missing: false,
+    };
+};
+
+/** The releases that an error points at: their indexes, or every release of the repository. */
+type Unusable = Set<number> | 'all';
+
+/** `tail` is the path below the repository node; an error that names no release index spoils every release of the repository. */
+const markUnusable = (marks: Map<number | string, Unusable>, slot: number | string, tail: unknown[]) => {
+    const current = marks.get(slot);
+    if (current === 'all') {
+        return;
+    }
+    const [list, nodes, index] = tail;
+    if (list !== 'releases' || nodes !== 'nodes' || typeof index !== 'number') {
+        marks.set(slot, 'all');
+        return;
+    }
+    const indexes = current ?? new Set<number>();
+    indexes.add(index);
+    marks.set(slot, indexes);
+};
+
+/** Release objects that arrived whole and that no error points at. */
+const countUsableReleases = (node: RepositoryNode | null | undefined, unusable: Unusable | undefined) => {
+    if (!node?.releases || unusable === 'all') {
+        return 0;
+    }
+    let count = 0;
+    for (const [index, release] of node.releases.nodes.entries()) {
+        if (release !== null && !unusable?.has(index)) {
+            count++;
+        }
+    }
+    return count;
+};
+
+const isResourceError = (error: GraphqlError) => error.type === 'RESOURCE_LIMITS_EXCEEDED';
+
+export const parseOwnerPage = (result: GraphqlResult): ParsedPage => {
+    const failedEdges = new Set<number>();
+    const unusable = new Map<number | string, Unusable>();
+    const described: Array<{ text: string; ownerAbsent: boolean }> = [];
+    for (const error of result.errors) {
+        const [root, connection, list, index] = error.path ?? [];
+        if (root === 'owner' && connection === 'repositories' && list === 'edges' && typeof index === 'number') {
+            failedEdges.add(index);
+            markUnusable(unusable, index, error.path?.[4] === 'node' ? error.path.slice(5) : []);
+        } else {
+            described.push({ text: describeGraphqlError(error), ownerAbsent: error.type === 'NOT_FOUND' && error.path?.length === 1 && root === 'owner' });
+        }
+    }
+    const resourceLimited = result.errors.some((error) => isResourceError(error));
+    const parsed = ownerPageSchema.safeParse(result.data ?? {});
+    const owner = parsed.success ? parsed.data.owner : undefined;
+    // Only a response whose every error says the owner is absent confirms it; any other error leaves it unconfirmed.
+    const ownerMissing = owner === null && described.length > 0 && described.every((error) => error.ownerAbsent);
+    const pageErrors = ownerMissing ? [] : described.map((error) => error.text);
+    if (!owner) {
+        return {
+            slots: [],
+            returnedReleases: 0,
+            resourceLimited,
+            hasNextPage: false,
+            endCursor: null,
+            pageErrors: pageErrors.length > 0 ? pageErrors : ['GitHub GraphQL returned no repository list'],
+            ownerMissing,
+        };
+    }
+    const slots = owner.repositories.edges.map((edge, index) => (edge === null ? toSlot(null, null, true) : toSlot(edge.cursor, edge.node, failedEdges.has(index))));
+    return {
+        slots,
+        returnedReleases: owner.repositories.edges.reduce((sum, edge, index) => sum + countUsableReleases(edge?.node, unusable.get(index)), 0),
+        resourceLimited,
+        hasNextPage: owner.repositories.pageInfo.hasNextPage,
+        endCursor: owner.repositories.pageInfo.endCursor,
+        pageErrors,
+        ownerMissing: false,
+    };
+};
+
+export const parseRepositoriesPage = (result: GraphqlResult, aliases: string[]): ParsedPage => {
+    const failedAliases = new Set<string>();
+    const missingAliases = new Set<string>();
+    const unusable = new Map<number | string, Unusable>();
+    const pageErrors: string[] = [];
+    for (const error of result.errors) {
+        const root = error.path?.[0];
+        if (typeof root === 'string' && aliases.includes(root)) {
+            markUnusable(unusable, root, error.path?.slice(1) ?? []);
+            if (error.type === 'NOT_FOUND') {
+                missingAliases.add(root);
+            } else {
+                failedAliases.add(root);
+            }
+        } else {
+            // Without a path an error, RESOURCE_LIMITS_EXCEEDED included, may concern any repository of the response.
+            pageErrors.push(describeGraphqlError(error));
+        }
+    }
+    let returnedReleases = 0;
+    const slots = aliases.map((alias): RepositorySlot => {
+        const node = repositorySlotSchema.parse(result.data?.[alias]);
+        returnedReleases += countUsableReleases(node, unusable.get(alias));
+        if (node === null && missingAliases.has(alias)) {
+            return { cursor: null, repository: null, complete: true, missing: true };
+        }
+        return toSlot(null, node, failedAliases.has(alias));
+    });
+    return {
+        slots,
+        returnedReleases,
+        resourceLimited: result.errors.some((error) => isResourceError(error)),
+        hasNextPage: false,
+        endCursor: null,
+        pageErrors,
+        ownerMissing: false,
+    };
+};
+
+/** The cost of the query and the points left, null when the response has no rateLimit. */
+export const readRateLimit = (result: GraphqlResult) => {
+    const parsed = rateLimitSchema.safeParse(result.data?.rateLimit);
+    return parsed.success ? parsed.data : null;
+};
+
+/** The next asset page of one release, null when the response cannot be trusted. */
+export const parseAssetsPage = (result: GraphqlResult) => {
+    const parsed = assetsPageSchema.safeParse(result.data ?? {});
+    if (result.errors.length > 0 || !parsed.success || !parsed.data.node) {
+        return null;
+    }
+    return parsed.data.node.releaseAssets;
+};
