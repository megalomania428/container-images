+                await warm.ended;
+                expect(warm.store.writes).toHaveLength(2);
+                expect(warm.store.writes[1]).toMatchObject({ lastStatus: 'complete' });
+            } finally {
+                responder = answer;
+            }
+        });
+
+        it('writes nothing for a batch of filtered out releases and does not take it for a result', async () => {
+            const budget = config.github.releases.maxRetriesTime;
+            config.github.releases.maxRetriesTime = '-1';
+            responder = (graphqlRequest) => {
+                if (graphqlRequest.variables.after !== null) {
+                    return new Response('{}', { status: 502 });
+                }
+                const node = { ...repositoryNode('filtered-org', 'app'), releases: { pageInfo: { hasNextPage: false, endCursor: null }, nodes: [releaseNode('filtered-org', 'app', 'v2-beta', true)] } };
