+        expect(finishCrawl(partial, { succeeded: 1, failed: [], warnings: [] }, new Set(), now + 2 * hour, hour)).toMatchObject({ lastStatus: 'complete', failureCount: 0, nextAttemptAt: 0 });
+    });
+
+    it('backs off after complete failures without extending the freshness', () => {
+        let state = finishCrawl(emptyState(), { succeeded: 1, failed: [], warnings: [] }, new Set(), now, hour);
+        const delays: number[] = [];
+        for (let failure = 0; failure < 8; failure++) {
+            state = finishCrawl(state, { succeeded: 0, failed: ['org: HTTP 502'], warnings: [] }, new Set(), now, hour);
+            delays.push((state.nextAttemptAt - now) / 1000);
+        }
+        expect(delays).toEqual([60, 120, 240, 480, 960, 1920, 3600, 3600]);
+        expect(state).toMatchObject({ lastSuccessAt: now, lastStatus: 'failed', failureCount: 8 });
+    });
+
+    it('repeats a crawl with errors after its backoff, also when a complete failure follows a partial result', () => {
+        const done = finishCrawl(emptyState(), { succeeded: 1, failed: [], warnings: [] }, new Set(), now, hour);
+        expect(isDue(done, now + hour - 1, hour)).toBe(false);
+        expect(isDue(done, now + hour, hour)).toBe(true);
+        const partial = finishCrawl(done, { succeeded: 1, failed: ['other: HTTP 502'], warnings: [] }, new Set(), now + hour, hour);
+        expect(isDue(partial, now + hour + 60 * 1000 - 1, hour)).toBe(false);
+        expect(isDue(partial, now + hour + 60 * 1000, hour)).toBe(true);
+        const failed = finishCrawl(partial, { succeeded: 0, failed: ['org: HTTP 502'], warnings: [] }, new Set(), now + hour + 60 * 1000, hour);
+        expect(failed).toMatchObject({ lastSuccessAt: now + hour, lastStatus: 'failed', failureCount: 2 });
+        expect(isDue(failed, now + hour + 3 * 60 * 1000 - 1, hour)).toBe(false);
+        expect(isDue(failed, now + hour + 3 * 60 * 1000, hour)).toBe(true);
+        expect(isDue(emptyState(), now, hour)).toBe(true);
+    });
+
+    it('forgets releases out of the window only after a complete crawl, never those still in the feed', async () => {
+        const state = await observe(emptyState(), [release('RE_kept'), release('RE_gone')]);
+        const trimmed = { ...state, entries: state.entries.filter((entry) => entry.snapshot.releaseId === 'RE_kept') };
+        const partial = finishCrawl(trimmed, { succeeded: 1, failed: ['x'], warnings: [] }, new Set(), 0, hour);
+        expect(tracked(partial)).toEqual(new Set(['RE_gone', 'RE_kept']));
+        const complete = finishCrawl(trimmed, { succeeded: 1, failed: [], warnings: [] }, new Set(), 0, hour);
+        expect(tracked(complete)).toEqual(new Set(['RE_kept']));
+        const stillSeen = finishCrawl(trimmed, { succeeded: 1, failed: [], warnings: [] }, new Set(['RE_gone']), 0, hour);
+        expect(tracked(stillSeen)).toEqual(new Set(['RE_gone', 'RE_kept']));
+    });
+});
+
+describe('entries', () => {
+    it('build titles from the repository, the version and the flags', async () => {
+        const state = await observe(emptyState(), [release('RE_1', { name: 'Version 1', tagName: 'v1', isPrerelease: true })]);
+        expect(entryTitle(state.entries[0])).toBe('org/app Version 1 (v1) [pre-release] (Demo module)');
+        const plain = await observe(emptyState(), [release('RE_2', { name: null, tagName: 'v2' })]);
+        expect(entryTitle({ ...plain.entries[0], snapshot: { ...plain.entries[0].snapshot, repositoryDescription: '' } })).toBe('org/app v2');
+        const updated = await observe(plain, [release('RE_2', { name: null, tagName: 'v2', description: 'more' })]);
+        expect(entryTitle(updated.entries[0])).toBe('[updated] org/app v2 (Demo module)');
+    });
+
+    it('list every asset with an escaped name and a size, linking only https URLs', async () => {
+        const state = await observe(emptyState(), [
+            release('RE_1', {
+                releaseAssets: {
+                    pageInfo: { hasNextPage: false, endCursor: null },
+                    nodes: [asset('A1', { name: '<b>app</b>.apk', size: 2048 }), asset('A2', { name: 'tool.zip', downloadUrl: 'javascript:alert(1)', size: 10 })],
+                },
+            }),
+        ]);
+        const html = entryDescription(state.entries[0].snapshot);
+        expect(html).toContain('<p>notes</p>');
+        expect(html).toContain('<a href="https://github.com/org/app/releases/download/v1/A1.apk">&lt;b&gt;app&lt;/b&gt;.apk (2.0 KiB)</a>');
+        expect(html).toContain('<li>tool.zip (10 B)</li>');
+        expect(html).not.toContain('javascript:');
