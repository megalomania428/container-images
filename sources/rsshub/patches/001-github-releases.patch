+const ownerData = (edges: unknown[], hasNextPage = false) => ({ owner: { repositories: { pageInfo: { hasNextPage, endCursor: edges.length > 0 ? `c${edges.length - 1}` : null }, edges } } });
+
+const edge = (index: number, releases: unknown[]) => ({ cursor: `c${index}`, node: repositoryNode(index, releases) });
+
+const result = (data: GraphqlResult['data'], errors: GraphqlError[] = []): GraphqlResult => ({ data, errors, pauseMs: null });
+
+// Like the queue of the RSSHub fetch: the call never settles and ignores the signal.
+const deafFetch = () => new Promise<Response>(() => {});
+const deafBody = () => Promise.resolve({ status: 200, headers: new Headers(), text: () => new Promise<string>(() => {}) } as unknown as Response);
+
+const nulled = (id: string) => ({ ...release(id), descriptionHTML: null });
+const limited = (...path: Array<string | number>) => ({ type: 'RESOURCE_LIMITS_EXCEEDED', path, message: 'Resource limits for this query exceeded.' });
+
+const serveRedirect = async (status: number) => {
+    const visited: string[] = [];
+    const server = http.createServer((request, response) => {
+        visited.push(`${request.method} ${request.url}`);
+        if (request.url === '/graphql') {
+            response.statusCode = status;
+            response.setHeader('location', '/moved');
+            response.end();
+            return;
+        }
+        response.setHeader('content-type', 'application/json');
+        response.end('{"data":{"moved":true}}');
+    });
+    await new Promise<void>((resolve) => server.listen(0, '127.0.0.1', resolve));
+    const { port } = server.address() as AddressInfo;
+    return { visited, url: `http://127.0.0.1:${port}/graphql`, close: () => server.close() };
+};
+
+const limitedFetch = () => Promise.resolve(new Response('limited', { status: 403, headers: { 'retry-after': '60' } }));
+const htmlFetch = () => Promise.resolve(new Response('<html>504 Gateway Time-out</html>', { status: 200, headers: { 'content-type': 'text/html' } }));
+const foreignFetch = () => Promise.resolve(Response.json([1, 2]));
+const offlineFetch = () => Promise.reject(new TypeError('fetch failed'));
+
+afterEach(() => {
