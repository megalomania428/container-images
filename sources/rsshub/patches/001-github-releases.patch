+        ['/github/releases/org/valid-org?release_type=draft', 'release_type must be one of all, stable, prerelease'],
+        ['/github/releases/org/valid-org?per_repo=0', 'per_repo must be an integer from 1 to 22'],
+        ['/github/releases/org/valid-org?per_repo=23', 'per_repo must be an integer from 1 to 22'],
+        ['/github/releases/org/valid-org?per_repo=2.5', 'per_repo must be an integer from 1 to 22'],
+        ['/github/releases/org/valid-org?include_forks=yes', 'include_forks must be one of true, false'],
+        ['/github/releases/org/valid-org?include_archived=1', 'include_archived must be one of true, false'],
+        ['/github/releases/org/-bad', 'Invalid logins'],
+        ['/github/releases/org/a,,b', 'Invalid logins'],
+        ['/github/releases/repo/owner-only', 'Invalid owner/name repositories'],
+        ['/github/releases/repo/owner/name/extra', 'Invalid owner/name repositories'],
+        ['/github/releases/org/o1,o2,o3,o4,o5,o6,o7,o8', 'the limit is 7 (GITHUB_RELEASES_MAX_OWNERS)'],
+    ])('rejects %s', async (path, message) => {
+        const before = requests.length;
+        expect(await readError(path)).toContain(message);
+        expect(requests).toHaveLength(before);
+    });
+
+    it('answers by the response timeout with an empty feed while the same crawl goes on', async () => {
+        const gate = Promise.withResolvers<void>();
+        responder = async (graphqlRequest) => {
+            await gate.promise;
+            return answer(graphqlRequest);
+        };
+        try {
+            const feeds = await Promise.all([readFeed('/github/releases/org/slow-org'), readFeed('/github/releases/org/slow-org')]);
+            for (const feed of feeds) {
+                expect(feed.items).toEqual([]);
+                expect(feed.description).toContain('Preparing the feed');
+            }
+            gate.resolve();
+            await vi.waitFor(
+                async () => {
+                    expect((await readFeed('/github/releases/org/slow-org')).items).toHaveLength(2);
+                },
+                { timeout: 5000, interval: 100 }
+            );
+            expect(forLogin('slow-org')).toHaveLength(1);
+        } finally {
+            gate.resolve();
+            responder = answer;
+        }
+    });
+
+    describe('state writes of a crawl', () => {
+        it.each([
+            ['org', 'warm-org', 3, 4],
+            ['user', 'warm-user', 3, 4],
+            ['repo', repoTargets(150), 2, 3],
+        ] as const)('writes the state once in a warm %s crawl however many batches it reads', async (mode, targets, batches, coldWrites) => {
+            if (mode !== 'repo') {
+                responder = pagedOwner(batches);
+            }
+            const maxRepos = config.github.releases.maxRepos;
+            config.github.releases.maxRepos = '150';
+            try {
+                const cold = await startCrawl(mode, targets);
+                await cold.ended;
+                expect(cold.store.writes).toHaveLength(coldWrites);
+                const warm = await startCrawl(mode, targets, { now: later });
+                await warm.ended;
+                expect(warm.store.writes).toHaveLength(1);
+                expect(warm.store.writes[0]).toMatchObject({ lastStatus: 'complete', failureCount: 0 });
+                expect(warm.store.writes[0].entries).toEqual(cold.store.writes.at(-1)?.entries);
