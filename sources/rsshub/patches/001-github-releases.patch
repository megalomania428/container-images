+import type { Route } from '@/types';
+import { handleReleases } from '@/utils/github-releases/handler';
+
+export const route: Route = {
+    path: '/releases/:mode{(?:org|user|repo)}/:targets{.+}',
+    categories: ['programming'],
+    example: '/github/releases/org/Xposed-Modules-Repo',
+    parameters: {
+        mode: {
+            description: 'Kind of the sources',
+            options: [
+                { value: 'org', label: 'Organizations' },
+                { value: 'user', label: 'Users' },
+                { value: 'repo', label: 'Repositories' },
+            ],
+        },
+        targets: 'Comma-separated logins for `org` and `user`, comma-separated `owner/name` pairs for `repo`',
+    },
+    features: {
+        requireConfig: [
+            {
+                name: 'GITHUB_ACCESS_TOKEN',
+                description: 'GitHub access token: GitHub GraphQL requires authentication even for public data',
+            },
+        ],
+    },
+    name: 'Releases of organizations, users or repositories',
+    maintainers: ['raven428'],
+    handler: handleReleases,
+    description: `New and changed published releases of public repositories, read only through GitHub GraphQL. Examples: \`/github/releases/org/org1,org2\`, \`/github/releases/user/user1\`, \`/github/releases/repo/owner1/project1,owner2/project2\`.
+
+Query parameters:
+
+- \`release_type\`: \`all\` (default), \`stable\` or \`prerelease\`; drafts are never included.
+- \`per_repo\`: 1 to 22, default 3, the window of the latest created releases of every repository before the filters.
+- \`include_forks\`, \`include_archived\`: \`true\` or \`false\` (default), also for repositories listed explicitly.
+- \`limit\` only shortens the response; the feed holds at most 111 entries, revisions included.
+
+A release is published only when the latest of its publication and update times is older than \`GITHUB_RELEASES_MIN_AGE\`. A significant change of a published release (name, tag, pre-release flag, notes or assets) adds a new entry marked \`[updated]\` and keeps the previous ones. The feed is checked again after \`GITHUB_RELEASES_REFRESH_INTERVAL\`, or after 1, 2, 4 and more minutes when the last crawl had errors; a request waits for the running crawl at most \`GITHUB_RELEASES_RESPONSE_TIMEOUT\` and gets the entries ready so far, the crawl goes on in the background.
+
+Settings, whole seconds unless noted, an empty value keeps the default: \`GITHUB_RELEASES_RESPONSE_TIMEOUT\` (10), \`GITHUB_RELEASES_CRAWL_DEADLINE\` (1800), \`GITHUB_RELEASES_REFRESH_INTERVAL\` (3600), \`GITHUB_RELEASES_MIN_AGE\` (5940, 0 disables the delay), \`GITHUB_RELEASES_MAX_OWNERS\` (7 logins), \`GITHUB_RELEASES_MAX_REPOS\` (33 repositories), \`GITHUB_RELEASES_CONCURRENCY\` (2 GraphQL requests per process), \`GITHUB_RELEASES_ATTEMPT_TIMEOUT\` (30), \`GITHUB_RELEASES_MAX_RETRIES_TIME\` (111, the budget of pauses between retries, negative disables retries, 0 keeps the default), \`GITHUB_RELEASES_BACKOFF_INITIAL\` (1), \`GITHUB_RELEASES_BACKOFF_STEP\` (1), \`GITHUB_RELEASES_BACKOFF_STEP_ATTEMPTS\` (3 attempts), \`GITHUB_RELEASES_BACKOFF_CAP\` (7), \`GITHUB_RELEASES_GRAPHQL_URL\` (\`https://api.github.com/graphql\`).`,
+};
diff -ruN -x .git a/lib/utils/github-releases/backoff.test.ts b/lib/utils/github-releases/backoff.test.ts
--- a/lib/utils/github-releases/backoff.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/utils/github-releases/backoff.test.ts	2026-11-18 19:59:39.556644796 +0000
@@ -0,0 +1,85 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+import { applyBackoffDefaults, backoffDelay, defaultBackoff, RetryBudget, sleep } from './backoff';
+
+// The flat schedule of the go-lib-ci tests: 1 ms pauses within a 10 ms budget.
+const fast = { maxRetriesTime: 10, backoffInitial: 1, backoffStep: 1, backoffStepAttempts: 3, backoffCap: 1 };
+
+afterEach(() => {
+    vi.useRealTimers();
+});
+
+describe('backoffDelay', () => {
+    it('follows the go-lib-ci schedule with the defaults', () => {
+        const delays = Array.from({ length: 25 }, (_value, attempt) => backoffDelay(attempt, defaultBackoff) / 1000);
+        expect(delays).toEqual([1, 1, 1, 2, 2, 2, 3, 3, 3, 4, 4, 4, 5, 5, 5, 6, 6, 6, 7, 7, 7, 7, 7, 7, 1]);
+    });
+
+    it('stops growing at the cap and restarts the cycle', () => {
+        // capBlocks = trunc(7 / 3) = 2, cycle = (2 + 1) * 2 = 6 attempts
+        const options = { maxRetriesTime: 100, backoffInitial: 2, backoffStep: 3, backoffStepAttempts: 2, backoffCap: 7 };
+        expect(Array.from({ length: 8 }, (_value, attempt) => backoffDelay(attempt, options))).toEqual([2, 2, 5, 5, 7, 7, 2, 2]);
+    });
+});
+
+describe('applyBackoffDefaults', () => {
+    it('replaces zero and non-positive values with the defaults', () => {
+        expect(applyBackoffDefaults({ maxRetriesTime: 0, backoffInitial: 0, backoffStep: -1, backoffStepAttempts: 0, backoffCap: -5 })).toEqual(defaultBackoff);
+    });
+
+    it('keeps a negative budget that disables retries', () => {
+        expect(applyBackoffDefaults({ ...defaultBackoff, maxRetriesTime: -1 }).maxRetriesTime).toBe(-1);
+    });
+});
+
+describe('RetryBudget', () => {
+    it('spends the default budget of 111 seconds on pauses only', () => {
+        const budget = new RetryBudget(defaultBackoff);
+        const waits: number[] = [];
+        for (let wait = budget.next(); wait !== null; wait = budget.next()) {
+            waits.push(wait / 1000);
+        }
+        expect(waits).toEqual([1, 1, 1, 2, 2, 2, 3, 3, 3, 4, 4, 4, 5, 5, 5, 6, 6, 6, 7, 7, 7, 7, 7, 7, 1, 1, 1, 2]);
+        expect(budget.waited).toBe(110 * 1000);
+    });
+
+    it('disables retries with a negative budget', () => {
+        expect(new RetryBudget({ ...defaultBackoff, maxRetriesTime: -1 }).next()).toBeNull();
+    });
+
+    it('counts server pauses in the same budget as the backoff', () => {
+        const budget = new RetryBudget(fast);
+        expect(budget.next(5)).toBe(6);
+        expect(budget.next()).toBe(1);
+        expect(budget.next(5)).toBeNull();
+    });
+
+    it('gives up when the server pause and the backoff exceed the budget', () => {
+        const budget = new RetryBudget({ ...defaultBackoff, backoffInitial: 60 * 1000, backoffCap: 60 * 1000 });
+        expect(budget.next(60 * 1000)).toBeNull();
+    });
+
+    it('ignores negative server pauses', () => {
+        expect(new RetryBudget(fast).next(-3_600_000)).toBe(1);
+    });
+});
+
+describe('sleep', () => {
+    it('resolves after the delay', async () => {
+        vi.useFakeTimers();
+        const settled = vi.fn();
+        void sleep(1000).then(settled);
+        await vi.advanceTimersByTimeAsync(999);
+        expect(settled).not.toHaveBeenCalled();
+        await vi.advanceTimersByTimeAsync(1);
+        expect(settled).toHaveBeenCalledOnce();
+    });
+
+    it('resolves early without rejecting when the signal aborts', async () => {
+        vi.useFakeTimers();
+        const controller = new AbortController();
+        const pending = sleep(60 * 1000, controller.signal);
+        controller.abort(new Error('stop'));
+        await expect(pending).resolves.toBeUndefined();
+    });
+});
diff -ruN -x .git a/lib/utils/github-releases/backoff.ts b/lib/utils/github-releases/backoff.ts
--- a/lib/utils/github-releases/backoff.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/utils/github-releases/backoff.ts	2026-11-18 19:59:39.556644796 +0000
@@ -0,0 +1,82 @@
+/**
+ * Retry schedule ported from go-lib-ci: BackoffOptions, applyBackoffDefaults and backoffDelay of fetch.go and the
+ * shared pause budget of retryAPI in ghrelease.go. All durations are milliseconds.
+ */
+export type BackoffOptions = {
+    /** Budget for the sum of pauses between attempts: 0 keeps the default, a negative value disables retries. */
+    maxRetriesTime: number;
+    /** The first pause, a non-positive value keeps the default. */
+    backoffInitial: number;
+    /** Added to the pause once every backoffStepAttempts attempts, a non-positive value keeps the default. */
+    backoffStep: number;
+    /** Attempts in each block of equal pauses, a non-positive value keeps the default. */
+    backoffStepAttempts: number;
+    /** The longest single pause, after a block at this level the schedule restarts from backoffInitial. */
+    backoffCap: number;
+};
+
+export const defaultBackoff: BackoffOptions = {
+    maxRetriesTime: 111 * 1000,
+    backoffInitial: 1000,
+    backoffStep: 1000,
+    backoffStepAttempts: 3,
+    backoffCap: 7 * 1000,
+};
+
+export const applyBackoffDefaults = (options: BackoffOptions): BackoffOptions => ({
+    maxRetriesTime: options.maxRetriesTime === 0 ? defaultBackoff.maxRetriesTime : options.maxRetriesTime,
+    backoffInitial: options.backoffInitial > 0 ? options.backoffInitial : defaultBackoff.backoffInitial,
+    backoffStep: options.backoffStep > 0 ? options.backoffStep : defaultBackoff.backoffStep,
+    backoffStepAttempts: options.backoffStepAttempts > 0 ? options.backoffStepAttempts : defaultBackoff.backoffStepAttempts,
+    backoffCap: options.backoffCap > 0 ? options.backoffCap : defaultBackoff.backoffCap,
+});
+
+/** The pause after the failed attempt with this zero-based number. */
+export const backoffDelay = (attempt: number, options: BackoffOptions) => {
+    const capBlocks = Math.trunc(options.backoffCap / options.backoffStep);
+    const cycle = (capBlocks + 1) * options.backoffStepAttempts;
+    const delay = Math.trunc((attempt % cycle) / options.backoffStepAttempts) * options.backoffStep + options.backoffInitial;
+    return Math.min(delay, options.backoffCap);
+};
+
+/** One budget of pauses for a logical request together with its recovery steps. */
+export class RetryBudget {
+    #attempt = 0;
+    #waited = 0;
+    readonly #options: BackoffOptions;
+
+    constructor(options: BackoffOptions) {
+        this.#options = options;
+    }
+
+    get waited() {
+        return this.#waited;
+    }
+
+    /** Accounts the pause before the next attempt, a pause requested by the server included; null means give up. */
+    next(requestedPause = 0) {
+        const wait = backoffDelay(this.#attempt, this.#options) + Math.max(requestedPause, 0);
+        this.#attempt++;
+        if (this.#options.maxRetriesTime <= 0 || this.#waited + wait > this.#options.maxRetriesTime) {
+            return null;
+        }
+        this.#waited += wait;
+        return wait;
+    }
+}
+
+/** Resolves after the delay or as soon as the signal aborts; it never rejects, so callers check the signal. */
+export const sleep = (ms: number, signal?: AbortSignal) =>
+    new Promise<void>((resolve) => {
+        if (signal?.aborted) {
+            resolve();
+            return;
+        }
+        const finish = () => {
+            clearTimeout(timer);
+            signal?.removeEventListener('abort', finish);
+            resolve();
+        };
+        const timer = setTimeout(finish, Math.max(ms, 0));
+        signal?.addEventListener('abort', finish, { once: true });
+    });
diff -ruN -x .git a/lib/utils/github-releases/crawl.test.ts b/lib/utils/github-releases/crawl.test.ts
--- a/lib/utils/github-releases/crawl.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/utils/github-releases/crawl.test.ts	2026-11-18 19:59:39.556644796 +0000
@@ -0,0 +1,948 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+import { defaultBackoff } from './backoff';
+import type { CrawlBatch, CrawlParams } from './crawl';
+import { crawl } from './crawl';
+import type { GitHubRelease, GraphqlVariables } from './graphql';
+import type { ReleasesSettings } from './settings';
+
+const now = Date.parse('2026-06-01T00:00:00Z');
+const old = '2026-01-01T00:00:00Z';
+// The flat schedule of the go-lib-ci tests: 1 ms pauses within a 10 ms budget.
+const fast = { maxRetriesTime: 10, backoffInitial: 1, backoffStep: 1, backoffStepAttempts: 3, backoffCap: 1 };
+const resourceMessage = 'Resource limits for this query exceeded.';
+
+const settings = (overrides: Partial<ReleasesSettings> = {}): ReleasesSettings => ({
+    token: 'token',
+    graphqlUrl: 'http://graphql.test/graphql',
+    responseTimeoutMs: 10 * 1000,
+    crawlDeadlineMs: 1800 * 1000,
+    refreshIntervalMs: 3600 * 1000,
+    minAgeMs: 5940 * 1000,
+    maxOwners: 7,
+    maxRepos: 33,
+    concurrency: 2,
+    attemptTimeoutMs: 30 * 1000,
+    backoff: defaultBackoff,
+    ...overrides,
+});
+
+const params = (overrides: Partial<CrawlParams> = {}): CrawlParams => ({ mode: 'org', targets: ['org'], releaseType: 'all', perRepo: 3, includeForks: false, includeArchived: false, ...overrides });
+
+const asset = (id: string) => ({ id, name: `${id}.apk`, downloadUrl: `https://github.com/org/a/releases/download/v1/${id}.apk`, size: 10, contentType: 'application/vnd.android.package-archive', updatedAt: old });
+
+const release = (id: string, overrides: Partial<GitHubRelease> = {}): GitHubRelease => ({
+    id,
+    databaseId: 1,
+    name: id,
+    tagName: id,
+    url: `https://github.com/org/a/releases/tag/${id}`,
+    isDraft: false,
+    isPrerelease: false,
+    createdAt: old,
+    publishedAt: old,
+    updatedAt: old,
+    description: 'notes',
+    descriptionHTML: '<p>notes</p>',
+    releaseAssets: { pageInfo: { hasNextPage: false, endCursor: null }, nodes: [asset(`${id}-asset`)] },
+    ...overrides,
+});
+
+type RepositoryFlags = {
+    isFork?: boolean;
+    isArchived?: boolean;
+};
+
+const repository = (name: string, releases: Array<GitHubRelease | null>, flags: RepositoryFlags = {}) => ({
+    id: `R_${name}`,
+    nameWithOwner: `org/${name}`,
+    description: `${name} module`,
+    url: `https://github.com/org/${name}`,
+    isFork: false,
+    isArchived: false,
+    isPrivate: false,
+    ...flags,
+    releases: { pageInfo: { hasNextPage: false, endCursor: null }, nodes: releases },
+});
+
+type RepositoryNode = ReturnType<typeof repository>;
+
+const numbered = (count: number, releases: (index: number) => Array<GitHubRelease | null>) => Array.from({ length: count }, (_value, index) => repository(`m${String(index).padStart(3, '0')}`, releases(index)));
+
+/** Serves repositories like GitHub: the edges after the cursor, at most `size` of them. */
+const ownerPage = (repositories: RepositoryNode[], variables: GraphqlVariables) => {
+    const start = variables.after === null ? 0 : Number(String(variables.after).slice(1)) + 1;
+    const nodes = repositories.slice(start, start + Number(variables.size));
+    const edges = nodes.map((node, offset) => ({ cursor: `c${start + offset}`, node }));
+    return { owner: { repositories: { pageInfo: { hasNextPage: start + nodes.length < repositories.length, endCursor: edges.at(-1)?.cursor ?? null }, edges } } };
+};
+
+type GraphqlRequest = {
+    operation: string;
+    variables: GraphqlVariables;
+};
+
+type Responder = (request: GraphqlRequest, signal?: AbortSignal | null) => Response | Promise<Response>;
+
+/** A GitHub GraphQL double that records requests and rejects any other endpoint. */
+const github = (responder: Responder) => {
+    const requests: GraphqlRequest[] = [];
+    const fetch = (input: string, init: RequestInit) => {
+        if (input !== 'http://graphql.test/graphql') {
+            return Promise.reject(new Error(`unexpected request to ${input}`));
+        }
+        const { query, variables } = JSON.parse(String(init.body)) as { query: string; variables: GraphqlVariables };
+        const request = { operation: /query (\w+)/.exec(query)?.[1] ?? '', variables };
+        requests.push(request);
+        return Promise.resolve(responder(request, init.signal));
+    };
+    return { requests, fetch };
+};
+
+/** A request that never answers until it is aborted. */
+const hang = (signal?: AbortSignal | null) =>
+    new Promise<Response>((_resolve, reject) => {
+        if (signal?.aborted) {
+            reject(signal.reason);
+            return;
+        }
+        signal?.addEventListener('abort', () => reject(signal.reason), { once: true });
+    });
+
+const deps = (fetch: (input: string, init: RequestInit) => Promise<Response>, waits: number[] = []) => ({
+    fetch,
+    now: () => now,
+    sleep: (ms: number) => {
+        waits.push(ms);
+        return Promise.resolve();
+    },
+});
+
+const collector = () => {
+    const batches: CrawlBatch[] = [];
+    const commit = (batch: CrawlBatch) => {
+        batches.push(batch);
+        return Promise.resolve();
+    };
+    const ids = () => batches.flatMap((batch) => batch.releases.map(({ release: item }) => item.id));
+    return { batches, commit, ids };
+};
+
+const openSignal = () => new AbortController().signal;
+
+const resourceError = (path: Array<string | number>) => ({ type: 'RESOURCE_LIMITS_EXCEEDED', path, message: resourceMessage });
+
+const notFound = (path?: Array<string | number>) => ({ type: 'NOT_FOUND', path, message: 'Could not resolve to an owner' });
+
+describe('crawl of owners', () => {
+    it('keeps the page size of 100 over five pages and follows endCursor', async () => {
+        const repositories = numbered(500, (index) => Array.from({ length: index % 4 }, (_value, number) => release(`RE_${index}_${number}`)));
+        const { requests, fetch } = github(({ variables }) => Response.json({ data: ownerPage(repositories, variables) }));
+        const { commit, ids } = collector();
+        expect(await crawl(params(), settings(), deps(fetch), openSignal(), commit)).toEqual({ succeeded: 1, failed: [], warnings: [] });
+        expect(requests.map(({ variables }) => [variables.login, variables.after, variables.size, variables.perRepo])).toEqual([
+            ['org', null, 100, 3],
+            ['org', 'c99', 100, 3],
+            ['org', 'c199', 100, 3],
+            ['org', 'c299', 100, 3],
+            ['org', 'c399', 100, 3],
+        ]);
+        expect(ids()).toHaveLength(750);
+        expect(new Set(ids()).size).toBe(750);
+    });
+
+    it('keeps the confirmed prefix after RESOURCE_LIMITS_EXCEEDED and resumes after it with a smaller page', async () => {
+        const repositories = numbered(150, (index) => [release(`RE_${index}_0`), release(`RE_${index}_1`), release(`RE_${index}_2`)]);
+        let limited = true;
+        const { requests, fetch } = github(({ variables }) => {
+            const data = ownerPage(repositories, variables);
+            if (!limited) {
+                return Response.json({ data });
+            }
+            limited = false;
+            // From the 41st repository on GitHub nulls two release objects of every repository.
+            for (const edge of data.owner.repositories.edges.slice(40)) {
+                edge.node = { ...edge.node, releases: { ...edge.node.releases, nodes: [edge.node.releases.nodes[0], null, null] } };
+            }
+            return Response.json({ data, errors: [resourceError(['owner', 'repositories', 'edges', 40, 'node', 'releases', 'nodes', 1])] });
+        });
