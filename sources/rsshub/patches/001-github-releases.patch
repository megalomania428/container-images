+                await expect(crawl.result).rejects.toThrow('crawl failed');
+                await crawl.ended;
+                expect(crawl.store.writes).toHaveLength(1);
+                expect(crawl.store.writes[0]).toMatchObject({ lastStatus: 'failed', entries: [] });
+            } finally {
+                config.github.releases.maxRetriesTime = budget;
+                responder = answer;
+            }
+        });
+
+        it('counts an unchanged batch with releases as progress of a crawl that fails later', async () => {
+            const budget = config.github.releases.maxRetriesTime;
+            responder = pagedOwner(2);
+            try {
+                await (
+                    await startCrawl('org', 'progress-org')
+                ).ended;
+                config.github.releases.maxRetriesTime = '-1';
+                responder = (graphqlRequest) => (graphqlRequest.variables.after === null ? pagedOwner(2)(graphqlRequest) : new Response('{}', { status: 502 }));
