--- a/lib/utils/github-releases/handler.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/utils/github-releases/handler.ts	2026-11-18 20:18:20.051729081 +0000
@@ -0,0 +1,246 @@
+import type { Context } from 'hono';
+
+import ConfigNotFoundError from '@/errors/types/config-not-found';
+import InvalidParameterError from '@/errors/types/invalid-parameter';
+import type { Data } from '@/types';
+import logger from '@/utils/logger';
+
+import { sleep } from './backoff';
+import type { CrawlOutcome, CrawlParams, ReleaseType, SourceMode } from './crawl';
+import { crawl } from './crawl';
+import { applyBatch, compareText, emptyState, fingerprintReleases, finishCrawl, isDue, renderFeed, sha256Hex } from './feed';
+import { describeCause } from './graphql';
+import type { ReleasesSettings } from './settings';
+import { loadSettings } from './settings';
+import type { ReleasesStore } from './store';
+import { selectStore } from './store';
+
+export type HandlerDeps = {
+    fetch: (input: string, init: RequestInit) => Promise<Response>;
+    now: () => number;
+    /** Resolves after the delay or as soon as the signal aborts, it never rejects. */
+    sleep: (ms: number, signal?: AbortSignal) => Promise<void>;
+    /** A unique token of a crawl lease. */
+    token: () => string;
+    store: () => ReleasesStore;
+};
+
+const defaultDeps: HandlerDeps = {
+    fetch: (input, init) => fetch(input, init),
+    now: () => Date.now(),
+    sleep,
+    token: () => crypto.randomUUID(),
+    store: selectStore,
+};
+
+/** The lease outlives the crawl deadline by this margin, so only a crashed process lets it expire mid-crawl. */
+const leaseMarginMs = 60 * 1000;
+const leasePollMs = 1000;
+
+/** Crawls running in this process by task key; each promise resolves when its crawl ends and never rejects. */
+const localTasks = new Map<string, Promise<void>>();
+
+const ownerPattern = /^[\da-z][\da-z-]{0,38}$/;
+const repositoryNamePattern = /^[\w.-]{1,100}$/;
+
+const isTarget = (mode: SourceMode, target: string) => {
+    if (mode !== 'repo') {
+        return ownerPattern.test(target);
+    }
+    const [owner, name, extra] = target.split('/', 3);
+    return extra === undefined && name !== undefined && ownerPattern.test(owner) && repositoryNamePattern.test(name) && name !== '.' && name !== '..';
+};
+
+/** Clients may encode the separators as %2F and %2C; a valid source never holds %, so a second decoding is harmless. */
+const decodeTargets = (value: string) => {
+    if (!value.includes('%')) {
+        return value;
+    }
+    try {
+        return decodeURIComponent(value);
+    } catch {
+        return value;
+    }
+};
+
+const readChoice = <T extends string>(name: string, value: string | undefined, choices: readonly T[], fallback: T): T => {
+    if (value === undefined) {
+        return fallback;
+    }
+    const choice = choices.find((item) => item === value);
+    if (choice === undefined) {
+        throw new InvalidParameterError(`${name} must be one of ${choices.join(', ')}`);
+    }
+    return choice;
+};
+
+const readPerRepo = (value: string | undefined) => {
+    if (value === undefined) {
+        return 3;
+    }
+    const parsed = Number(value);
+    if (!/^\d+$/.test(value) || parsed < 1 || parsed > 22) {
+        throw new InvalidParameterError('per_repo must be an integer from 1 to 22');
+    }
+    return parsed;
+};
+
+/** Validates the route parameters and builds the normalized task: case, order and duplicates of sources do not matter. */
+export const parseRequest = (ctx: Context, settings: ReleasesSettings): CrawlParams => {
+    const mode = readChoice('mode', ctx.req.param('mode'), ['org', 'user', 'repo'] as const, 'org');
+    const parts = decodeTargets(ctx.req.param('targets') ?? '')
+        .split(',')
+        .map((part) => part.trim().toLowerCase());
+    const invalid = parts.filter((part) => !isTarget(mode, part));
+    if (invalid.length > 0) {
+        throw new InvalidParameterError(`Invalid ${mode === 'repo' ? 'owner/name repositories' : 'logins'}: ${invalid.map((part) => JSON.stringify(part)).join(', ')}`);
+    }
+    const targets = [...new Set(parts)].toSorted(compareText);
+    const limit = mode === 'repo' ? settings.maxRepos : settings.maxOwners;
+    if (targets.length > limit) {
+        throw new InvalidParameterError(`Too many sources: ${targets.length}, the limit is ${limit} (GITHUB_RELEASES_${mode === 'repo' ? 'MAX_REPOS' : 'MAX_OWNERS'})`);
+    }
+    return {
+        mode,
+        targets,
+        releaseType: readChoice<ReleaseType>('release_type', ctx.req.query('release_type'), ['all', 'stable', 'prerelease'], 'all'),
+        perRepo: readPerRepo(ctx.req.query('per_repo')),
+        includeForks: readChoice('include_forks', ctx.req.query('include_forks'), ['true', 'false'] as const, 'false') === 'true',
+        includeArchived: readChoice('include_archived', ctx.req.query('include_archived'), ['true', 'false'] as const, 'false') === 'true',
+    };
+};
+
+/** Everything that changes the content of the feed; the format and limit of a response do not. */
+export const taskKey = async (params: CrawlParams) => (await sha256Hex(JSON.stringify([params.mode, params.targets, params.releaseType, params.perRepo, params.includeForks, params.includeArchived]))).slice(0, 40);
+
+const stateTtl = (settings: ReleasesSettings) => Math.max(7 * 24 * 60 * 60 * 1000, 24 * settings.refreshIntervalMs);
+
+const logOutcome = (key: string, outcome: CrawlOutcome) => {
+    for (const problem of [...outcome.failed, ...outcome.warnings]) {
+        logger.warn(`GitHub releases: crawl ${key}: ${problem}`);
+    }
+    logger.info(`GitHub releases: crawl ${key} finished, ${outcome.succeeded} sources read, ${outcome.failed.length} failed, ${outcome.warnings.length} warnings`);
+};
+
+const runTask = async (key: string, token: string, params: CrawlParams, settings: ReleasesSettings, store: ReleasesStore, deps: HandlerDeps) => {
+    const controller = new AbortController();
+    // oxlint-disable-next-line unicorn-js/prefer-abort-signal-timeout -- the crawl also aborts when its lease is lost
+    const deadline = setTimeout(() => controller.abort(new Error('the crawl deadline is exceeded')), settings.crawlDeadlineMs);
+    const seen = new Set<string>();
+    let progressed = false;
+    try {
+        let state = (await store.read(key)) ?? emptyState();
+        const outcome = await crawl(params, settings, deps, controller.signal, async (batch) => {
+            const digests = await fingerprintReleases(batch.releases);
+            // The state is replaced synchronously, so batches of parallel sources cannot overwrite each other.
+            const next = applyBatch(state, batch.releases, digests);
+            const changed = next !== state;
+            state = next;
+            for (const id of batch.seen) {
+                seen.add(id);
+            }
+            if (!changed) {
+                // Its releases are stored already; a lost lease shows up at the next write.
+                progressed ||= batch.releases.length > 0;
+                return;
+            }
+            if (await store.write(key, token, state, stateTtl(settings))) {
+                // Only stored releases make a result; a batch of filtered out releases alone does not.
+                progressed ||= batch.releases.length > 0;
+            } else {
+                controller.abort(new Error('the crawl lease is lost'));
+            }
+        });
+        logOutcome(key, outcome);
+        state = finishCrawl(state, outcome, seen, deps.now(), settings.refreshIntervalMs, progressed);
+        if (!(await store.write(key, token, state, stateTtl(settings)))) {
+            logger.warn(`GitHub releases: crawl ${key} lost its lease, its result is dropped`);
+        }
+    } catch (error) {
+        logger.error(`GitHub releases: crawl ${key} failed: ${describeCause(error)}`);
+        try {
+            const current = (await store.read(key)) ?? emptyState();
+            await store.write(key, token, finishCrawl(current, { succeeded: 0, failed: [describeCause(error)], warnings: [] }, seen, deps.now(), settings.refreshIntervalMs, progressed), stateTtl(settings));
+        } catch (writeError) {
+            logger.error(`GitHub releases: crawl ${key} could not record its failure: ${describeCause(writeError)}`);
+        }
+    } finally {
+        clearTimeout(deadline);
+        try {
+            await store.release(key, token);
+        } catch (error) {
+            logger.error(`GitHub releases: crawl ${key} could not release its lease: ${describeCause(error)}`);
+        }
+        localTasks.delete(key);
+    }
+};
+
+/** Starts one crawl when the feed is due and no process holds the lease of the task. */
+const startIfDue = async (key: string, params: CrawlParams, settings: ReleasesSettings, store: ReleasesStore, deps: HandlerDeps) => {
+    if (localTasks.has(key) || !isDue((await store.read(key)) ?? emptyState(), deps.now(), settings.refreshIntervalMs)) {
+        return;
+    }
+    const token = deps.token();
+    if (!(await store.acquire(key, token, settings.crawlDeadlineMs + leaseMarginMs))) {
+        return;
+    }
+    let due: boolean;
+    try {
+        // Another process may have finished the same task between the check and the lease.
+        due = isDue((await store.read(key)) ?? emptyState(), deps.now(), settings.refreshIntervalMs);
+    } catch (error) {
+        // A lease left behind would hold off new crawls of the task until it expires.
+        await Promise.allSettled([store.release(key, token)]);
+        throw error;
+    }
+    if (!due) {
+        // The state is fresh, so a lease that cannot be released only expires later.
+        await Promise.allSettled([store.release(key, token)]);
+        return;
+    }
+    localTasks.set(key, runTask(key, token, params, settings, store, deps));
+};
+
+/** Waits for the running crawl of the task, at most GITHUB_RELEASES_RESPONSE_TIMEOUT, and returns early when it ends. */
+const waitForProgress = async (key: string, settings: ReleasesSettings, store: ReleasesStore, deps: HandlerDeps) => {
+    const until = deps.now() + settings.responseTimeoutMs;
+    for (;;) {
+        const remaining = until - deps.now();
+        if (remaining <= 0) {
+            return;
+        }
+        const local = localTasks.get(key);
+        if (local) {
+            const stop = new AbortController();
+            // oxlint-disable-next-line no-await-in-loop -- the wait ends with the local crawl or with the response timeout
+            await Promise.race([local, deps.sleep(remaining, stop.signal)]);
+            stop.abort();
+            return;
+        }
+        // oxlint-disable-next-line no-await-in-loop -- a crawl of another process is visible only through its lease
+        if ((await store.holder(key)) === null) {
+            return;
+        }
+        // oxlint-disable-next-line no-await-in-loop -- polls the lease of a crawl in another process
+        await deps.sleep(Math.min(leasePollMs, remaining));
+    }
+};
+
+/**
+ * Serves the stored snapshot of the task. A due update starts one background crawl, the request waits for it at
+ * most GITHUB_RELEASES_RESPONSE_TIMEOUT, and the crawl goes on after the response until it ends or hits its deadline.
+ */
+export const handleReleases = async (ctx: Context, deps: HandlerDeps = defaultDeps): Promise<Data> => {
+    const settings = loadSettings();
+    if (!settings.token) {
+        throw new ConfigNotFoundError('GITHUB_ACCESS_TOKEN is required by /github/releases: GitHub GraphQL needs a token even for public data');
+    }
+    const params = parseRequest(ctx, settings);
+    const key = await taskKey(params);
+    const store = deps.store();
+    await startIfDue(key, params, settings, store, deps);
+    await waitForProgress(key, settings, store, deps);
+    const state = (await store.read(key)) ?? emptyState();
+    const running = localTasks.has(key) || (await store.holder(key)) !== null;
+    return renderFeed(params, state, running);
+};
