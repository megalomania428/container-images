--- a/lib/utils/github-releases/settings.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/utils/github-releases/settings.ts	2026-11-18 19:59:39.564644990 +0000
@@ -0,0 +1,75 @@
+import type { Config } from '@/config';
+import { config } from '@/config';
+import ConfigNotFoundError from '@/errors/types/config-not-found';
+
+import type { BackoffOptions } from './backoff';
+import { applyBackoffDefaults } from './backoff';
+
+/** Raw GITHUB_RELEASES_* values from lib/config.ts. */
+export type ReleasesConfig = Config['github']['releases'];
+
+export type ReleasesSettings = {
+    token?: string;
+    graphqlUrl: string;
+    responseTimeoutMs: number;
+    crawlDeadlineMs: number;
+    refreshIntervalMs: number;
+    minAgeMs: number;
+    maxOwners: number;
+    maxRepos: number;
+    concurrency: number;
+    attemptTimeoutMs: number;
+    backoff: BackoffOptions;
+};
+
+export const defaultGraphqlUrl = 'https://api.github.com/graphql';
+
+const second = 1000;
+
+const readInteger = (name: string, value: string | undefined, fallback: number, minimum?: number) => {
+    const text = value?.trim() ?? '';
+    if (text === '') {
+        return fallback;
+    }
+    const parsed = Number(text);
+    if (!/^-?\d+$/.test(text) || !Number.isSafeInteger(parsed)) {
+        throw new ConfigNotFoundError(`GITHUB_RELEASES_${name} must be an integer, got "${text}"`);
+    }
+    if (minimum !== undefined && parsed < minimum) {
+        throw new ConfigNotFoundError(`GITHUB_RELEASES_${name} must be at least ${minimum}, got ${parsed}`);
+    }
+    return parsed;
+};
+
+const readUrl = (value: string | undefined) => {
+    const text = value?.trim() ?? '';
+    if (text === '') {
+        return defaultGraphqlUrl;
+    }
+    if (!URL.canParse(text) || !['http:', 'https:'].includes(new URL(text).protocol)) {
+        // The value is not echoed: an endpoint may carry credentials.
+        throw new ConfigNotFoundError('GITHUB_RELEASES_GRAPHQL_URL must be an http or https URL');
+    }
+    return text;
+};
+
+/** Validates the settings on every request, so a broken value is reported instead of a silent default. */
+export const loadSettings = (raw: ReleasesConfig = config.github.releases, token: string | undefined = config.github.access_token): ReleasesSettings => ({
+    token: token || undefined,
+    graphqlUrl: readUrl(raw.graphqlUrl),
+    responseTimeoutMs: readInteger('RESPONSE_TIMEOUT', raw.responseTimeout, 10, 0) * second,
+    crawlDeadlineMs: readInteger('CRAWL_DEADLINE', raw.crawlDeadline, 1800, 1) * second,
+    refreshIntervalMs: readInteger('REFRESH_INTERVAL', raw.refreshInterval, 3600, 1) * second,
+    minAgeMs: readInteger('MIN_AGE', raw.minAge, 5940, 0) * second,
+    maxOwners: readInteger('MAX_OWNERS', raw.maxOwners, 7, 1),
+    maxRepos: readInteger('MAX_REPOS', raw.maxRepos, 33, 1),
+    concurrency: readInteger('CONCURRENCY', raw.concurrency, 2, 1),
+    attemptTimeoutMs: readInteger('ATTEMPT_TIMEOUT', raw.attemptTimeout, 30, 1) * second,
+    backoff: applyBackoffDefaults({
+        maxRetriesTime: readInteger('MAX_RETRIES_TIME', raw.maxRetriesTime, 0) * second,
+        backoffInitial: readInteger('BACKOFF_INITIAL', raw.backoffInitial, 0) * second,
+        backoffStep: readInteger('BACKOFF_STEP', raw.backoffStep, 0) * second,
+        backoffStepAttempts: readInteger('BACKOFF_STEP_ATTEMPTS', raw.backoffStepAttempts, 0),
+        backoffCap: readInteger('BACKOFF_CAP', raw.backoffCap, 0) * second,
+    }),
+});
diff -ruN -x .git a/lib/utils/github-releases/store.test.ts b/lib/utils/github-releases/store.test.ts
--- a/lib/utils/github-releases/store.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/utils/github-releases/store.test.ts	2026-11-18 19:59:39.564644990 +0000
@@ -0,0 +1,131 @@
+import type { Socket } from 'node:net';
+import { createServer } from 'node:net';
+
+import Redis from 'ioredis';
+import { LRUCache } from 'lru-cache';
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+
+import wait from '@/utils/wait';
+
+import { emptyState } from './feed';
+import type { ReleasesStore } from './store';
+import { createMemoryStore, createRedisStore, leaseKey, stateKey } from './store';
+
+const stored = { ...emptyState(), lastSuccessAt: 1, lastStatus: 'complete' as const };
+
+/** The lease contract shared by every store; `first` and `second` stand for two processes. */
+const checkLease = async (first: ReleasesStore, second: ReleasesStore, key: string) => {
+    expect(await first.acquire(key, 'token-1', 60 * 1000)).toBe(true);
+    expect(await second.acquire(key, 'token-2', 60 * 1000)).toBe(false);
+    expect(await second.holder(key)).toBe('token-1');
+    expect(await second.write(key, 'token-2', stored, 60 * 1000)).toBe(false);
+    expect(await second.read(key)).toBeNull();
+    expect(await first.write(key, 'token-1', stored, 60 * 1000)).toBe(true);
+    expect(await second.read(key)).toEqual(stored);
+    await second.release(key, 'token-2');
+    expect(await first.holder(key)).toBe('token-1');
+    await first.release(key, 'token-1');
+    expect(await second.holder(key)).toBeNull();
+};
+
+/** An expired lease lets a new crawl in, and the stale crawl can no longer write. */
+const checkExpiry = async (first: ReleasesStore, second: ReleasesStore, key: string) => {
+    expect(await first.acquire(key, 'stale', 50)).toBe(true);
+    await wait(120);
+    expect(await second.acquire(key, 'fresh', 60 * 1000)).toBe(true);
+    expect(await first.write(key, 'stale', stored, 60 * 1000)).toBe(false);
+    await first.release(key, 'stale');
+    expect(await second.holder(key)).toBe('fresh');
+    await second.release(key, 'fresh');
+};
+
+describe('memory store', () => {
+    const lru = new LRUCache<string, string>({ max: 100, ttl: 60 * 1000 });
+    const store = createMemoryStore(lru);
+
+    it('gives the lease to one crawl and lets only its holder write', async () => {
+        await checkLease(store, store, 'memory-lease');
+    });
+
+    it('lets a new crawl in after the lease expires', async () => {
+        await checkExpiry(store, store, 'memory-expiry');
+    });
+
+    it('keeps the lease of a running crawl when other entries fill the cache', async () => {
+        const small = new LRUCache<string, string>({ max: 2, ttl: 60 * 1000 });
+        const crowded = createMemoryStore(small);
+        expect(await crowded.acquire('memory-crowded', 'token-1', 60 * 1000)).toBe(true);
+        for (let index = 0; index < 5; index++) {
+            small.set(`other-${index}`, 'response');
+        }
+        expect(await crowded.acquire('memory-crowded', 'token-2', 60 * 1000)).toBe(false);
+        expect(await crowded.write('memory-crowded', 'token-1', stored, 60 * 1000)).toBe(true);
+        await crowded.release('memory-crowded', 'token-1');
+        expect(await crowded.holder('memory-crowded')).toBeNull();
+    });
+
+    it('drops an unreadable state', async () => {
+        lru.set(stateKey('memory-broken'), '{"version":');
+        expect(await store.read('memory-broken')).toBeNull();
+        lru.set(stateKey('memory-foreign'), '{"version":2}');
+        expect(await store.read('memory-foreign')).toBeNull();
+    });
+});
+
+// Two clients stand for two RSSHub processes that share one Redis.
+describe.skipIf(process.env.RSSHUB_BUILD_TEST === '1')('redis store', () => {
+    const prefix = `test-${Date.now()}-${Math.random().toString(16).slice(2)}`;
+    let clients: Redis[] = [];
+
+    beforeAll(() => {
+        const url = process.env.REDIS_URL || 'redis://localhost:6379/';
+        clients = [new Redis(url), new Redis(url)];
+    });
+
+    afterAll(async () => {
+        await clients[0].del(...['lease', 'expiry'].flatMap((name) => [stateKey(`${prefix}-${name}`), leaseKey(`${prefix}-${name}`)]));
+        await Promise.all(clients.map((client) => client.quit()));
+    });
+
+    it('gives the lease to one process and lets only its holder write', async () => {
+        const [first, second] = clients.map((client) => createRedisStore(client));
+        await checkLease(first, second, `${prefix}-lease`);
+    });
+
+    it('lets another process in after the lease expires', async () => {
+        const [first, second] = clients.map((client) => createRedisStore(client));
+        await checkExpiry(first, second, `${prefix}-expiry`);
+    });
+});
+
+describe('redis store that does not answer', () => {
+    it('gives up on every command after its timeout', async () => {
+        const sockets: Socket[] = [];
+        // A local listener that accepts connections and never replies stands for a Redis lost in the network.
+        const server = createServer((socket) => {
+            sockets.push(socket);
+        });
+        await new Promise<void>((resolve) => {
+            server.listen(0, '127.0.0.1', resolve);
+        });
+        const address = server.address();
+        if (address === null || typeof address === 'string') {
+            throw new TypeError('the listener has no TCP address');
+        }
+        const client = new Redis({ host: '127.0.0.1', port: address.port, enableReadyCheck: false, maxRetriesPerRequest: null });
+        try {
+            const silent = createRedisStore(client, 100);
+            await expect(silent.read('silent')).rejects.toThrow('Redis did not answer in time');
+            await expect(silent.acquire('silent', 'token', 60 * 1000)).rejects.toThrow('Redis did not answer in time');
+            await expect(silent.write('silent', 'token', stored, 60 * 1000)).rejects.toThrow('Redis did not answer in time');
+            await expect(silent.release('silent', 'token')).rejects.toThrow('Redis did not answer in time');
+            await expect(silent.holder('silent')).rejects.toThrow('Redis did not answer in time');
+        } finally {
+            client.disconnect();
+            for (const socket of sockets) {
+                socket.destroy();
+            }
+            server.close();
+        }
+    });
+});
diff -ruN -x .git a/lib/utils/github-releases/store.ts b/lib/utils/github-releases/store.ts
--- a/lib/utils/github-releases/store.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/utils/github-releases/store.ts	2026-11-18 19:59:39.564644990 +0000
@@ -0,0 +1,140 @@
+import type Redis from 'ioredis';
+import { LRUCache } from 'lru-cache';
+
+import { config } from '@/config';
+import cache from '@/utils/cache';
+import logger from '@/utils/logger';
+
+import type { FeedState } from './feed';
+import { feedStateSchema } from './feed';
+import { describeCause } from './graphql';
+
+/**
+ * Storage of the feed state and of the crawl lease. Writes and releases check the lease token, so a crawl that
+ * outlived its lease cannot overwrite the state of a newer one.
+ */
+export type ReleasesStore = {
+    kind: 'redis' | 'memory' | 'process';
+    read: (key: string) => Promise<FeedState | null>;
+    acquire: (key: string, token: string, ttlMs: number) => Promise<boolean>;
+    write: (key: string, token: string, state: FeedState, ttlMs: number) => Promise<boolean>;
+    release: (key: string, token: string) => Promise<void>;
+    holder: (key: string) => Promise<string | null>;
+};
+
+export const stateKey = (key: string) => `rsshub:github-releases:state:${key}`;
+export const leaseKey = (key: string) => `rsshub:github-releases:lease:${key}`;
+
+const parseState = (text: string | null | undefined) => {
+    if (!text) {
+        return null;
+    }
+    try {
+        const parsed = feedStateSchema.safeParse(JSON.parse(text));
+        if (parsed.success) {
+            return parsed.data;
+        }
+        logger.warn('GitHub releases: dropping a stored state of an unknown format');
+    } catch (error) {
+        logger.warn(`GitHub releases: dropping a stored state that is not JSON: ${describeCause(error)}`);
+    }
+    return null;
+};
+
+const writeScript = "if redis.call('GET', KEYS[1]) == ARGV[1] then redis.call('SET', KEYS[2], ARGV[2], 'PX', ARGV[3]) return 1 end return 0";
+const releaseScript = "if redis.call('GET', KEYS[1]) == ARGV[1] then redis.call('DEL', KEYS[1]) return 1 end return 0";
+
+/** Redis commands of the feed give up after this time, so a Redis that does not answer cannot hold a request or a crawl. */
+export const redisTimeoutMs = 3000;
+
+const timed = <T>(command: Promise<T>, timeoutMs: number) => {
+    const signal = AbortSignal.timeout(timeoutMs);
+    return Promise.race([
+        command,
+        new Promise<never>((_resolve, reject) => {
+            signal.addEventListener('abort', () => reject(new Error('Redis did not answer in time')), { once: true });
+        }),
+    ]);
+};
+
+/** Shared by every RSSHub process that uses the same Redis. */
+export const createRedisStore = (client: Redis, timeoutMs = redisTimeoutMs): ReleasesStore => ({
+    kind: 'redis',
+    read: async (key) => {
+        const raw = await timed(client.get(stateKey(key)), timeoutMs);
+        return parseState(raw);
+    },
+    acquire: async (key, token, ttlMs) => (await timed(client.set(leaseKey(key), token, 'PX', ttlMs, 'NX'), timeoutMs)) === 'OK',
+    write: async (key, token, state, ttlMs) => (await timed(client.eval(writeScript, 2, leaseKey(key), stateKey(key), token, JSON.stringify(state), ttlMs), timeoutMs)) === 1,
+    release: async (key, token) => {
+        await timed(client.eval(releaseScript, 1, leaseKey(key), token), timeoutMs);
+    },
+    holder: (key) => timed(client.get(leaseKey(key)), timeoutMs),
+});
+
+type ProcessLease = {
+    token: string;
+    expiresAt: number;
+};
+
+/**
+ * Leases of the stores private to this process. They stay out of the LRU, so other cache entries cannot evict the
+ * lease of a running crawl; a memory cache is private to the process anyway.
+ */
+const processLeases = new Map<string, ProcessLease>();
+
+const currentLease = (name: string) => {
+    const lease = processLeases.get(name);
+    if (lease !== undefined && lease.expiresAt <= Date.now()) {
+        processLeases.delete(name);
+        return null;
+    }
+    return lease?.token ?? null;
+};
+
+/** Every operation is synchronous inside one process, so nothing interleaves between a check and a change. */
+export const createMemoryStore = (lru: LRUCache<string, string>, kind: 'memory' | 'process' = 'memory'): ReleasesStore => ({
+    kind,
+    read: (key) => {
+        const raw = lru.get(stateKey(key), { updateAgeOnGet: false });
+        return Promise.resolve(parseState(raw));
+    },
+    acquire: (key, token, ttlMs) => {
+        if (currentLease(leaseKey(key)) !== null) {
+            return Promise.resolve(false);
+        }
+        processLeases.set(leaseKey(key), { token, expiresAt: Date.now() + ttlMs });
+        return Promise.resolve(true);
+    },
+    write: (key, token, state, ttlMs) => {
+        if (currentLease(leaseKey(key)) !== token) {
+            return Promise.resolve(false);
+        }
+        lru.set(stateKey(key), JSON.stringify(state), { ttl: ttlMs });
+        return Promise.resolve(true);
+    },
+    release: (key, token) => {
+        if (currentLease(leaseKey(key)) === token) {
+            processLeases.delete(leaseKey(key));
+        }
+        return Promise.resolve();
+    },
+    holder: (key) => Promise.resolve(currentLease(leaseKey(key))),
+});
+
+const processStore = createMemoryStore(new LRUCache<string, string>({ max: 512, ttl: 7 * 24 * 60 * 60 * 1000 }), 'process');
+
+/** Redis or the memory cache of RSSHub, otherwise a store private to this process. */
+export const selectStore = (): ReleasesStore => {
+    const { memoryCache, redisClient } = cache.clients;
+    if (config.cache.type === 'redis' && redisClient && cache.status.available) {
+        return createRedisStore(redisClient);
+    }
+    if (config.cache.type === 'memory' && memoryCache && cache.status.available) {
+        return createMemoryStore(memoryCache);
+    }
+    if (config.cache.type === 'redis') {
+        logger.warn('GitHub releases: Redis is unavailable, the crawl state stays in this process');
+    }
+    return processStore;
+};
