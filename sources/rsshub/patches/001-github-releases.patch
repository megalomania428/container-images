+                await (
+                    await startCrawl('org', 'mixed-org')
+                ).ended;
+                const gate = Promise.withResolvers<void>();
+                const unchanged = pagedOwner(3, new Set([1]));
+                responder = async (graphqlRequest) => {
+                    if (graphqlRequest.variables.after === 'c1') {
+                        await gate.promise;
+                    }
+                    return unchanged(graphqlRequest);
+                };
+                const warm = await startCrawl('org', 'mixed-org', { now: later });
