+const asset = (id: string) => ({ id, name: `${id}.apk`, downloadUrl: `https://github.com/o/r/releases/download/v1/${id}.apk`, size: 10, contentType: 'application/vnd.android.package-archive', updatedAt: '2026-01-01T00:00:00Z' });
