+import { describe, expect, it } from 'vitest';
+
+import ConfigNotFoundError from '@/errors/types/config-not-found';
+
+import { defaultBackoff } from './backoff';
+import { defaultGraphqlUrl, loadSettings } from './settings';
+
+describe('loadSettings', () => {
+    it('uses the documented defaults for unset and empty values', () => {
+        expect(loadSettings({ responseTimeout: '', maxOwners: '  ' }, 'token')).toEqual({
+            token: 'token',
+            graphqlUrl: defaultGraphqlUrl,
+            responseTimeoutMs: 10 * 1000,
+            crawlDeadlineMs: 1800 * 1000,
+            refreshIntervalMs: 3600 * 1000,
+            minAgeMs: 5940 * 1000,
+            maxOwners: 7,
+            maxRepos: 33,
+            concurrency: 2,
+            attemptTimeoutMs: 30 * 1000,
+            backoff: defaultBackoff,
+        });
+    });
+
+    it('reads every variable in whole seconds', () => {
+        const settings = loadSettings(
+            {
+                graphqlUrl: 'http://graphql.test/graphql',
+                responseTimeout: '0',
+                crawlDeadline: '60',
+                refreshInterval: '120',
+                minAge: '0',
+                maxOwners: '2',
+                maxRepos: '3',
+                concurrency: '4',
+                attemptTimeout: '5',
+                maxRetriesTime: '-1',
+                backoffInitial: '2',
+                backoffStep: '3',
+                backoffStepAttempts: '4',
+                backoffCap: '9',
+            },
+            'token'
+        );
+        expect(settings).toEqual({
+            token: 'token',
+            graphqlUrl: 'http://graphql.test/graphql',
+            responseTimeoutMs: 0,
+            crawlDeadlineMs: 60 * 1000,
+            refreshIntervalMs: 120 * 1000,
+            minAgeMs: 0,
+            maxOwners: 2,
+            maxRepos: 3,
+            concurrency: 4,
+            attemptTimeoutMs: 5 * 1000,
+            backoff: { maxRetriesTime: -1000, backoffInitial: 2000, backoffStep: 3000, backoffStepAttempts: 4, backoffCap: 9000 },
+        });
+    });
+
+    it('keeps the go-lib-ci defaults for zero and negative backoff values', () => {
+        expect(loadSettings({ maxRetriesTime: '0', backoffInitial: '-1', backoffStep: '0', backoffStepAttempts: '-3', backoffCap: '0' }, 'token').backoff).toEqual(defaultBackoff);
+    });
+
+    it.each([
+        ['responseTimeout', '1.5'],
+        ['responseTimeout', '-1'],
+        ['crawlDeadline', 'abc'],
+        ['crawlDeadline', '0'],
+        ['refreshInterval', '1e3'],
+        ['minAge', '-1'],
+        ['maxOwners', '0'],
+        ['maxRepos', '0'],
+        ['concurrency', '0'],
+        ['attemptTimeout', '0'],
+        ['backoffCap', '7s'],
+        ['maxRetriesTime', '99999999999999999999'],
+    ])('rejects %s=%s as a configuration error', (name, value) => {
+        expect(() => loadSettings(Object.fromEntries([[name, value]]), 'token')).toThrow(ConfigNotFoundError);
+    });
+
+    it('names the variable in the error', () => {
+        expect(() => loadSettings({ responseTimeout: 'ten' }, 'token')).toThrow('GITHUB_RELEASES_RESPONSE_TIMEOUT');
+    });
+
+    it('accepts only http and https GraphQL URLs', () => {
+        expect(() => loadSettings({ graphqlUrl: 'ftp://graphql.test/graphql' }, 'token')).toThrow(ConfigNotFoundError);
+        expect(() => loadSettings({ graphqlUrl: 'not a url' }, 'token')).toThrow(ConfigNotFoundError);
+    });
+
+    it('treats an empty token as missing', () => {
+        expect(loadSettings({}, '').token).toBeUndefined();
+    });
+});
