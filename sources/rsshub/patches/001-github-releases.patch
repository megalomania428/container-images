+    if (response.status !== 200) {
+        throw new TransientError(`GitHub GraphQL responded with HTTP ${response.status}`, { pauseMs: pauseMs ?? 0 });
+    }
+    let body: unknown;
+    try {
+        body = JSON.parse(text);
+    } catch (error) {
+        throw new TransientError('GitHub GraphQL returned a body that is not JSON', { cause: error, pauseMs: pauseMs ?? 0 });
+    }
+    const envelope = envelopeSchema.safeParse(body);
+    if (!envelope.success) {
+        throw new TransientError('GitHub GraphQL returned an unexpected JSON document', { pauseMs: pauseMs ?? 0 });
+    }
+    return { ...envelope.data, pauseMs };
