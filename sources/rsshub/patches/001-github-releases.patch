+import type { ReleasesSettings } from './settings';
+
+export type SourceMode = 'org' | 'user' | 'repo';
+export type ReleaseType = 'all' | 'stable' | 'prerelease';
+
+export type CrawlParams = {
+    mode: SourceMode;
+    /** Lowercase, unique and sorted logins, or owner/name pairs in repo mode. */
+    targets: string[];
+    releaseType: ReleaseType;
+    perRepo: number;
+    includeForks: boolean;
+    includeArchived: boolean;
+};
+
+export type CrawlDeps = {
+    fetch: (input: string, init: RequestInit) => Promise<Response>;
+    now: () => number;
+    /** Resolves after the delay or as soon as the signal aborts, it never rejects. */
+    sleep: (ms: number, signal?: AbortSignal) => Promise<void>;
+};
+
+export type ConfirmedRelease = {
+    repository: GitHubRepository;
+    release: GitHubRelease;
+};
+
+export type CrawlBatch = {
+    /** Releases that passed every filter and carry their complete asset list. */
+    releases: ConfirmedRelease[];
+    /** IDs of every release object read in the confirmed repositories, published or not. */
+    seen: string[];
+};
+
+export type CrawlOutcome = {
+    /** Sources (owners or repositories) read to the end. */
+    succeeded: number;
+    /** Sources that could not be read to the end. */
+    failed: string[];
+    /** Skipped elements of sources that were read, for example releases whose assets failed. */
+    warnings: string[];
+};
+
+type CrawlContext = {
+    params: CrawlParams;
+    settings: ReleasesSettings;
+    deps: CrawlDeps;
+    signal: AbortSignal;
+    commit: (batch: CrawlBatch) => Promise<void>;
+    /** The page size of every request of the crawl; RESOURCE_LIMITS_EXCEEDED in any source lowers it for all. */
+    pageSize: number;
+};
+
+const maxPageSize = 100;
+
+let activeRequests = 0;
+const waitingRequests = new Set<() => void>();
+
+/** Wakes the longest waiting request, if any. */
+const wakeNext = () => {
+    for (const wake of waitingRequests) {
+        waitingRequests.delete(wake);
+        wake();
+        return;
+    }
+};
+
+/** Limits concurrent GraphQL requests of the whole process to GITHUB_RELEASES_CONCURRENCY; a cancelled crawl stops waiting at once. */
+const withRequestSlot = async <T>(limit: number, signal: AbortSignal, request: () => Promise<T>): Promise<T> => {
+    while (activeRequests >= limit) {
+        signal.throwIfAborted();
+        // oxlint-disable-next-line no-await-in-loop -- a slot frees only when a running request ends
+        await new Promise<void>((resolve) => {
+            const wake = () => {
+                signal.removeEventListener('abort', wake);
+                waitingRequests.delete(wake);
+                resolve();
+            };
+            waitingRequests.add(wake);
+            signal.addEventListener('abort', wake, { once: true });
+        });
+        if (signal.aborted) {
+            // A free slot may have woken this request just before the abort, so the next waiting request gets it.
+            wakeNext();
+        }
+    }
+    signal.throwIfAborted();
+    activeRequests++;
+    try {
+        return await request();
+    } finally {
+        activeRequests--;
+        wakeNext();
+    }
+};
+
+type Attempted<T> = {
+    result: GraphqlResult;
+    /** What `read` made of the result while the request still held its slot. */
+    page: T;
+};
+
+/**
+ * One HTTP attempt; the variables are read once the request holds a slot, and `read` runs before the slot is freed, so a
+ * request that takes the slot next already sees what the response changed. Transient failures come back as values,
+ * cancellation and bugs are thrown.
+ */
+const attempt = async <T>(context: CrawlContext, query: string, variables: () => GraphqlVariables, read: (result: GraphqlResult) => T): Promise<Attempted<T> | TransientError> => {
+    const target = { url: context.settings.graphqlUrl, token: context.settings.token ?? '', attemptTimeoutMs: context.settings.attemptTimeoutMs };
+    try {
+        const attempted = await withRequestSlot(context.settings.concurrency, context.signal, async () => {
+            const result = await postGraphql(target, context.deps, query, variables(), context.signal);
+            return { result, page: read(result) };
+        });
+        const rateLimit = readRateLimit(attempted.result);
+        if (rateLimit !== null) {
+            logger.debug(`GitHub releases: the query cost ${rateLimit.cost} points, ${rateLimit.remaining} are left`);
+        }
+        return attempted;
+    } catch (error) {
+        if (error instanceof TransientError) {
+            return error;
+        }
+        throw error;
+    }
+};
+
+/** Spends the budget of the current logical page on a pause; false means the budget is exhausted. */
+const pause = async (context: CrawlContext, budget: RetryBudget, requestedPause: number, reason: string) => {
+    const wait = budget.next(requestedPause);
+    if (wait === null) {
+        logger.warn(`GitHub releases: ${reason}, the retry budget is spent`);
+        return false;
+    }
+    logger.warn(`GitHub releases: ${reason}, retrying in ${wait} ms`);
+    await context.deps.sleep(wait, context.signal);
+    context.signal.throwIfAborted();
+    return true;
+};
+
+const isWantedRepository = (repository: GitHubRepository, params: CrawlParams) => !repository.isPrivate && (params.includeForks || !repository.isFork) && (params.includeArchived || !repository.isArchived);
+
+const isWantedRelease = (release: GitHubRelease, releaseType: ReleaseType) => !release.isDraft && release.publishedAt !== null && (releaseType === 'all' || release.isPrerelease === (releaseType === 'prerelease'));
+
+/** The age counts from the latest of publishedAt and updatedAt, so a fresh edit waits as long as a new release. */
+const isOldEnough = (release: GitHubRelease, now: number, minAgeMs: number) => {
+    const changed = Math.max(Date.parse(release.publishedAt ?? ''), Date.parse(release.updatedAt));
+    return Number.isFinite(changed) && now - changed >= minAgeMs;
+};
+
+/** Reads the asset pages after the first hundred; null when the complete list cannot be confirmed. */
+const completeAssets = async (context: CrawlContext, budget: RetryBudget, release: GitHubRelease): Promise<GitHubRelease | null> => {
+    const assets = [...release.releaseAssets.nodes];
+    let { pageInfo } = release.releaseAssets;
+    while (pageInfo.hasNextPage) {
+        if (pageInfo.endCursor === null) {
+            return null;
+        }
+        // oxlint-disable-next-line no-await-in-loop -- every asset page continues after the cursor of the previous one
+        const attempted = await attempt(context, assetsQuery, () => ({ id: release.id, after: pageInfo.endCursor }), parseAssetsPage);
+        const page = attempted instanceof TransientError ? null : attempted.page;
+        if (page === null) {
+            const requestedPause = attempted instanceof TransientError ? attempted.pauseMs : (attempted.result.pauseMs ?? 0);
+            // oxlint-disable-next-line no-await-in-loop -- the same asset page is retried after the pause
+            if (!(await pause(context, budget, requestedPause, `assets of ${release.url} after ${pageInfo.endCursor}`))) {
+                return null;
+            }
+            continue;
+        }
+        assets.push(...page.nodes);
+        pageInfo = page.pageInfo;
+    }
+    return { ...release, releaseAssets: { pageInfo, nodes: assets } };
+};
+
+/**
+ * Filters complete repositories, completes asset lists and stores them; false if a release was skipped. Every release
+ * that needs no extra asset page is stored first, in one batch, then the releases with extra pages one by one, so a
+ * slow or failing asset list holds nothing else back.
+ */
+const confirm = async (context: CrawlContext, budget: RetryBudget, repositories: GitHubRepository[]) => {
+    const ready: ConfirmedRelease[] = [];
+    const extended: ConfirmedRelease[] = [];
+    const seen: string[] = [];
+    const now = context.deps.now();
+    for (const repository of repositories) {
+        if (!isWantedRepository(repository, context.params)) {
+            continue;
+        }
+        for (const release of repository.releases) {
+            seen.push(release.id);
+            if (isWantedRelease(release, context.params.releaseType) && isOldEnough(release, now, context.settings.minAgeMs)) {
+                (release.releaseAssets.pageInfo.hasNextPage ? extended : ready).push({ repository, release });
+            }
+        }
+    }
+    // A page without releases confirms nothing, so it is not a stored result of the crawl.
+    if (ready.length > 0 || seen.length > 0) {
+        await context.commit({ releases: ready, seen });
+    }
+    let complete = true;
+    for (const { repository, release } of extended) {
+        // oxlint-disable-next-line no-await-in-loop -- asset pages share the budget of the page, so they run one by one
+        const full = await completeAssets(context, budget, release);
+        if (full === null) {
+            logger.warn(`GitHub releases: skipped ${release.url}, its asset list is incomplete`);
+            complete = false;
+            continue;
+        }
+        // oxlint-disable-next-line no-await-in-loop -- every completed release is stored before the next one is read
+        await context.commit({ releases: [{ repository, release: full }], seen: [] });
+    }
+    return complete;
+};
+
+/** The continuous run of complete slots from the start of a page: only it may move the cursor. */
+const takePrefix = (slots: RepositorySlot[]) => {
+    let cursor: string | null = null;
+    let length = 0;
+    for (const slot of slots) {
+        if (!slot.complete) {
+            break;
+        }
+        length++;
+        if (slot.cursor !== null) {
+            cursor = slot.cursor;
+        }
+    }
+    return { cursor, length };
+};
+
+/** The page size after RESOURCE_LIMITS_EXCEEDED: max(1, floor(returned_releases / per_repo) - 1). */
+const shrinkPageSize = (returnedReleases: number, perRepo: number) => Math.max(1, Math.floor(returnedReleases / perRepo) - 1);
+
+/** Lowers the page size of the whole crawl after RESOURCE_LIMITS_EXCEEDED; it never grows back. */
+const lowerPageSize = (context: CrawlContext, page: ParsedPage) => {
+    if (page.resourceLimited) {
+        context.pageSize = Math.min(context.pageSize, shrinkPageSize(page.returnedReleases, context.params.perRepo));
+    }
+};
+
+const crawlOwner = async (context: CrawlContext, login: string): Promise<CrawlOutcome> => {
+    const query = ownerPageQuery(context.params.mode === 'user' ? 'user' : 'org');
+    const warnings: string[] = [];
+    let after: string | null = null;
+    let budget = new RetryBudget(context.settings.backoff);
+    for (;;) {
+        // oxlint-disable-next-line no-await-in-loop -- every page starts after the cursor confirmed by the previous one
+        const attempted = await attempt(
+            context,
+            query,
+            () => ({ login, after, size: context.pageSize, perRepo: context.params.perRepo }),
+            (result) => {
+                const parsed = parseOwnerPage(result);
+                lowerPageSize(context, parsed);
+                return parsed;
+            }
+        );
+        if (attempted instanceof TransientError) {
+            // oxlint-disable-next-line no-await-in-loop -- the same page is retried after the pause
+            if (!(await pause(context, budget, attempted.pauseMs, `${login}: ${attempted.message}`))) {
+                return { succeeded: 0, failed: [`${login}: ${attempted.message}`], warnings };
+            }
+            continue;
+        }
+        const { result, page } = attempted;
+        if (page.ownerMissing) {
+            return { succeeded: 0, failed: [`${login}: the ${context.params.mode === 'user' ? 'user' : 'organization'} was not found`], warnings };
+        }
+        // An error that names no repository may concern any of them: nothing of such a response is stored or confirmed.
+        const trusted = page.pageErrors.length === 0;
+        const prefix = takePrefix(page.slots);
+        if (trusted) {
+            // Complete repositories after a damaged one are stored too, but only the prefix moves the cursor.
+            const ready = page.slots.flatMap((slot) => (slot.complete && slot.repository !== null ? [slot.repository] : []));
+            // oxlint-disable-next-line no-await-in-loop -- complete repositories are stored before the next page is read
+            if (!(await confirm(context, budget, ready))) {
+                warnings.push(`${login}: some releases were skipped because their assets could not be read`);
+            }
+            if (prefix.cursor !== null) {
+                after = prefix.cursor;
+            }
+        }
+        const clean = trusted && !page.resourceLimited && prefix.length === page.slots.length;
+        if (clean && !page.hasNextPage) {
+            return { succeeded: 1, failed: [], warnings };
+        }
+        if (clean && page.endCursor !== null) {
+            after = page.endCursor;
+            budget = new RetryBudget(context.settings.backoff);
+            continue;
+        }
+        const reason = `${login}: ${page.resourceLimited ? 'RESOURCE_LIMITS_EXCEEDED' : [...page.pageErrors, 'incomplete repository data'].join('; ')}`;
+        // oxlint-disable-next-line no-await-in-loop -- the unconfirmed rest of the page is retried after the pause
+        if (!(await pause(context, budget, result.pauseMs ?? 0, reason))) {
+            return { succeeded: 0, failed: [reason], warnings };
+        }
+    }
+};
+
+/**
+ * Explicit repositories do not share a cursor: every complete one is stored and leaves the queue, and a repository that
+ * keeps failing until the retry budget is spent fails alone, the next ones get a budget of their own. A request of
+ * several repositories that keeps failing as a whole is split in halves, so a single repository that breaks the whole
+ * response fails alone too.
+ */
+const crawlRepositories = async (context: CrawlContext): Promise<CrawlOutcome> => {
+    const failed: string[] = [];
+    const warnings: string[] = [];
+    let succeeded = 0;
+    let pending = [...context.params.targets];
+    let size = Math.min(maxPageSize, pending.length);
+    let budget = new RetryBudget(context.settings.backoff);
+    while (pending.length > 0) {
+        const chunk = pending.slice(0, Math.min(size, context.pageSize));
+        const aliases = chunk.map((_target, index) => `r${index}`);
+        const pairs = chunk.flatMap((target, index): Array<[string, string]> => {
+            const [owner, name] = target.split('/', 2);
+            return [
+                [`o${index}`, owner],
+                [`n${index}`, name],
+            ];
+        });
+        const variables: GraphqlVariables = Object.fromEntries([...pairs, ['perRepo', context.params.perRepo]]);
+        // oxlint-disable-next-line no-await-in-loop -- the next chunk starts with the repositories this one did not confirm
+        const attempted = await attempt(
+            context,
+            repositoriesQuery(chunk.length),
+            () => variables,
+            (result) => {
+                const parsed = parseRepositoriesPage(result, aliases);
+                lowerPageSize(context, parsed);
+                return parsed;
+            }
+        );
+        let rest = chunk;
+        let reason = '';
+        if (attempted instanceof TransientError) {
+            reason = attempted.message;
+        } else {
+            const { page } = attempted;
+            // An error that names no repository may concern any of them: nothing of such a response is stored or confirmed.
+            const done = new Set<number>();
+            if (page.pageErrors.length === 0) {
+                const ready = page.slots.flatMap((slot) => (slot.complete && slot.repository !== null ? [slot.repository] : []));
+                // oxlint-disable-next-line no-await-in-loop -- complete repositories are stored before the next chunk is read
+                if (!(await confirm(context, budget, ready))) {
+                    warnings.push(`${chunk.filter((_target, index) => page.slots[index].complete).join(', ')}: some releases were skipped because their assets could not be read`);
+                }
+                for (const [index, slot] of page.slots.entries()) {
+                    if (slot.missing) {
+                        failed.push(`${chunk[index]}: the repository was not found`);
+                        done.add(index);
+                    } else if (slot.complete) {
+                        succeeded++;
+                        done.add(index);
+                    }
+                }
+            }
+            rest = chunk.filter((_target, index) => !done.has(index));
+            reason = page.resourceLimited ? 'RESOURCE_LIMITS_EXCEEDED' : [...page.pageErrors, 'incomplete repository data'].join('; ');
+        }
+        pending = [...rest, ...pending.slice(chunk.length)];
+        if (rest.length === 0) {
+            budget = new RetryBudget(context.settings.backoff);
+            continue;
+        }
+        const requestedPause = attempted instanceof TransientError ? attempted.pauseMs : (attempted.result.pauseMs ?? 0);
+        // oxlint-disable-next-line no-await-in-loop -- the unconfirmed repositories are retried after the pause
+        if (await pause(context, budget, requestedPause, `repositories: ${reason}`)) {
+            continue;
+        }
+        if (rest.length > 1) {
+            // The halves are capped by the page size of the crawl as well.
+            size = Math.min(size, Math.ceil(rest.length / 2));
+        } else {
+            failed.push(`${rest[0]}: ${reason}`);
+            pending = pending.slice(1);
+        }
+        budget = new RetryBudget(context.settings.backoff);
+    }
+    return { succeeded, failed, warnings };
+};
+
+const settle = async (label: string, run: () => Promise<CrawlOutcome>): Promise<CrawlOutcome> => {
+    try {
+        return await run();
+    } catch (error) {
+        return { succeeded: 0, failed: [`${label}: ${describeCause(error)}`], warnings: [] };
+    }
+};
+
+/**
+ * Reads every source page by page and hands each confirmed batch to commit before the next page, so a response
+ * timeout can serve what is ready while the same crawl goes on. It resolves even when sources fail or the signal
+ * aborts; the outcome tells what was read to the end.
+ */
+export const crawl = async (params: CrawlParams, settings: ReleasesSettings, deps: CrawlDeps, signal: AbortSignal, commit: (batch: CrawlBatch) => Promise<void>): Promise<CrawlOutcome> => {
+    const context: CrawlContext = { params, settings, deps, signal, commit, pageSize: maxPageSize };
+    const outcomes = params.mode === 'repo' ? [await settle('repositories', () => crawlRepositories(context))] : await Promise.all(params.targets.map((login) => settle(login, () => crawlOwner(context, login))));
+    let succeeded = 0;
+    for (const outcome of outcomes) {
+        succeeded += outcome.succeeded;
+    }
+    return {
+        succeeded,
+        failed: outcomes.flatMap((outcome) => outcome.failed),
+        warnings: outcomes.flatMap((outcome) => outcome.warnings),
+    };
+};
