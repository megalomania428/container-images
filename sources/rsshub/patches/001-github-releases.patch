+        } finally {
+            config.github.access_token = token;
+        }
+        expect(forLogin('token-org')).toHaveLength(0);
+    });
+
+    it('reports an invalid setting instead of using a default', async () => {
+        const value = config.github.releases.responseTimeout;
+        config.github.releases.responseTimeout = 'ten';
+        try {
+            expect(await readError('/github/releases/org/setting-org')).toContain('GITHUB_RELEASES_RESPONSE_TIMEOUT must be an integer');
+        } finally {
+            config.github.releases.responseTimeout = value;
+        }
+    });
+
+    it('ends a complete failure with an error instead of an endless empty feed and backs off', async () => {
+        const budget = config.github.releases.maxRetriesTime;
+        config.github.releases.maxRetriesTime = '-1';
+        responder = () => new Response('{}', { status: 502 });
+        try {
+            expect(await readError('/github/releases/org/down-org')).toContain('crawl failed');
+            expect(await readError('/github/releases/org/down-org')).toContain('crawl failed');
+            expect(forLogin('down-org')).toHaveLength(1);
+        } finally {
+            config.github.releases.maxRetriesTime = budget;
+            responder = answer;
+        }
+    });
+
+    it('ends with an error when the pages read before a failure hold no release for the filter', async () => {
+        const budget = config.github.releases.maxRetriesTime;
+        config.github.releases.maxRetriesTime = '-1';
+        responder = (graphqlRequest) => {
+            if (graphqlRequest.variables.login !== 'stable-org') {
+                return answer(graphqlRequest);
+            }
+            if (graphqlRequest.variables.after !== null) {
+                return new Response('{}', { status: 502 });
+            }
+            const node = { ...repositoryNode('stable-org', 'app'), releases: { pageInfo: { hasNextPage: false, endCursor: null }, nodes: [releaseNode('stable-org', 'app', 'v1', false)] } };
+            return Response.json({ data: { owner: { repositories: { pageInfo: { hasNextPage: true, endCursor: 'c0' }, edges: [{ cursor: 'c0', node }] } } } });
+        };
+        try {
+            expect(await readError('/github/releases/org/stable-org?release_type=prerelease')).toContain('crawl failed');
+            expect(forLogin('stable-org')).toHaveLength(2);
+        } finally {
+            config.github.releases.maxRetriesTime = budget;
+            responder = answer;
+        }
+    });
+
+    it('releases the lease when the state cannot be read after the lease is taken', async () => {
+        const { handleReleases } = await import('./handler');
+        const { sleep } = await import('./backoff');
+        const { selectStore } = await import('./store');
+        const store = selectStore();
+        const leased: string[] = [];
+        let reads = 0;
+        const flaky = {
+            ...store,
+            acquire: (key: string, token: string, ttlMs: number) => {
+                leased.push(key);
+                return store.acquire(key, token, ttlMs);
+            },
+            read: (key: string) => (++reads === 2 ? Promise.reject(new Error('Redis did not answer in time')) : store.read(key)),
+        };
+        const routeParams = { mode: 'org', targets: 'lease-org' };
