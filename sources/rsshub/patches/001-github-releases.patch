+            } finally {
+                config.github.releases.maxRetriesTime = budget;
+                responder = answer;
+            }
+        });
+
+        it('notices a lost lease at the first write, not at an unchanged batch', async () => {
+            responder = pagedOwner(4);
+            try {
+                await (
+                    await startCrawl('org', 'lost-org')
+                ).ended;
+                let lost = false;
+                const changed = pagedOwner(4, new Set([2]));
+                responder = (graphqlRequest) => {
+                    lost = true;
+                    return changed(graphqlRequest);
+                };
+                const before = forLogin('lost-org').length;
+                const warm = await startCrawl('org', 'lost-org', { now: later, accepts: () => !lost });
+                await warm.ended;
+                // Pages 0 and 1 are unchanged and write nothing, page 2 loses the lease and stops the crawl before page 3.
+                expect(forLogin('lost-org').length - before).toBe(3);
+                expect(warm.store.writes).toHaveLength(2);
+                expect(warm.store.writes[0].entries.some((entry) => entry.revision === 2)).toBe(true);
+            } finally {
+                responder = answer;
+            }
+        });
+    });
+
+    it('reports a missing token as a configuration error', async () => {
+        const token = config.github.access_token;
+        config.github.access_token = undefined;
