--- a/lib/utils/github-releases/feed.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/utils/github-releases/feed.ts	2026-11-18 19:59:39.560644893 +0000
@@ -0,0 +1,256 @@
+import { escapeAttribute, escapeText } from 'entities';
+import { z } from 'zod';
+
+import type { Data, DataItem } from '@/types';
+
+import type { ConfirmedRelease, CrawlOutcome, CrawlParams } from './crawl';
+import type { GitHubRelease, GitHubRepository } from './graphql';
+
+/** The common size limit of the feed, revisions included. */
+export const feedLimit = 111;
+
+const storedAssetSchema = z.object({
+    id: z.string(),
+    name: z.string(),
+    downloadUrl: z.string(),
+    size: z.number(),
+    contentType: z.string(),
+    updatedAt: z.string(),
+});
+
+const snapshotSchema = z.object({
+    releaseId: z.string(),
+    repository: z.string(),
+    repositoryDescription: z.string(),
+    name: z.string(),
+    tagName: z.string(),
+    url: z.string(),
+    isPrerelease: z.boolean(),
+    descriptionHTML: z.string(),
+    assets: z.array(storedAssetSchema),
+});
+
+const entrySchema = z.object({
+    guid: z.string(),
+    revision: z.number(),
+    pubDate: z.string(),
+    snapshot: snapshotSchema,
+});
+
+const trackSchema = z.object({
+    fingerprint: z.string(),
+    revision: z.number(),
+});
+
+export const feedStateSchema = z.object({
+    version: z.literal(1),
+    /** Published entries, newest first, at most feedLimit. */
+    entries: z.array(entrySchema),
+    /** The last published fingerprint and revision of every release still tracked, by GraphQL release ID. */
+    tracks: z.record(z.string(), trackSchema),
+    /** The end of the last crawl with successful results, the base of freshness. */
+    lastSuccessAt: z.number().nullable(),
+    lastStatus: z.enum(['never', 'complete', 'partial', 'failed']),
+    /** Crawls in a row that ended with errors, complete failures and partial results alike. */
+    failureCount: z.number(),
+    /** No new crawl starts before this time after a crawl with errors. */
+    nextAttemptAt: z.number(),
+});
+
+export type FeedState = z.output<typeof feedStateSchema>;
+export type FeedEntry = FeedState['entries'][number];
+export type ReleaseSnapshot = FeedEntry['snapshot'];
+
+export const emptyState = (): FeedState => ({
+    version: 1,
+    entries: [],
+    tracks: {},
+    lastSuccessAt: null,
+    lastStatus: 'never',
+    failureCount: 0,
+    nextAttemptAt: 0,
+});
+
+/** Code unit order, independent of the locale. */
+export const compareText = (left: string, right: string) => Number(left > right) - Number(left < right);
+
+export const sha256Hex = async (text: string) => {
+    const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
+    return Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, '0')).join('');
+};
+
+/**
+ * Digest of the significant fields. Dates, download counters and the rendered HTML stay out: the HTML may carry
+ * short-lived signed image links, so the Markdown source stands for the description.
+ */
+export const fingerprintRelease = (release: GitHubRelease) =>
+    sha256Hex(
+        JSON.stringify([
+            release.name ?? '',
+            release.tagName,
+            release.isPrerelease,
+            release.description ?? '',
+            release.releaseAssets.nodes.toSorted((left, right) => compareText(left.id, right.id)).map((asset) => [asset.id, asset.name, asset.downloadUrl, asset.size, asset.contentType]),
+        ])
+    );
+
+export const fingerprintReleases = (releases: ConfirmedRelease[]) => Promise.all(releases.map(({ release }) => fingerprintRelease(release)));
+
+const toSnapshot = (repository: GitHubRepository, release: GitHubRelease): ReleaseSnapshot => ({
+    releaseId: release.id,
+    repository: repository.nameWithOwner,
+    repositoryDescription: repository.description?.trim() ?? '',
+    name: release.name?.trim() ?? '',
+    tagName: release.tagName,
+    url: release.url,
+    isPrerelease: release.isPrerelease,
+    descriptionHTML: release.descriptionHTML ?? '',
+    assets: release.releaseAssets.nodes.map(({ id, name, downloadUrl, size, contentType, updatedAt }) => ({ id, name, downloadUrl, size, contentType, updatedAt })),
+});
+
+/** The latest change of a release or of its assets in milliseconds. */
+const latestChange = (release: GitHubRelease) => Math.max(...[release.updatedAt, ...release.releaseAssets.nodes.map((asset) => asset.updatedAt)].map((value) => Date.parse(value)).filter((value) => Number.isFinite(value)));
+
+/** The first revision keeps publishedAt, a later one takes the latest change of the release or its assets. */
+const entryDate = (release: GitHubRelease, revision: number) => {
+    if (revision === 1 && release.publishedAt) {
+        return new Date(release.publishedAt).toISOString();
+    }
+    return new Date(latestChange(release)).toISOString();
+};
+
+const compareEntries = (left: FeedEntry, right: FeedEntry) => Date.parse(right.pubDate) - Date.parse(left.pubDate) || compareText(right.guid, left.guid);
+
+/**
+ * Adds a revision for every new or changed release; digests come from fingerprintReleases in the same order. The guid
+ * carries the digest and the time of the latest change too, so a revision numbered again after a lost state cannot
+ * repeat a guid of other content, nor of the same content published before a later change back to it.
+ */
+export const applyBatch = (state: FeedState, releases: ConfirmedRelease[], digests: string[]): FeedState => {
+    const tracks = { ...state.tracks };
+    const added: FeedEntry[] = [];
+    for (const [index, { repository, release }] of releases.entries()) {
+        const digest = digests[index];
+        const track = Object.hasOwn(tracks, release.id) ? tracks[release.id] : undefined;
+        if (track?.fingerprint === digest) {
+            continue;
+        }
+        const revision = (track?.revision ?? 0) + 1;
+        tracks[release.id] = { fingerprint: digest, revision };
+        added.push({ guid: `${release.id}#r${revision}-${digest.slice(0, 12)}-${Math.floor(latestChange(release) / 1000).toString(36)}`, revision, pubDate: entryDate(release, revision), snapshot: toSnapshot(repository, release) });
+    }
+    if (added.length === 0) {
+        return state;
+    }
+    return { ...state, tracks, entries: [...state.entries, ...added].toSorted(compareEntries).slice(0, feedLimit) };
+};
+
+/** The pause after the given number of crawls in a row with errors: 1, 2, 4 and more minutes, at most the refresh interval. */
+const retryDelay = (failureCount: number, refreshIntervalMs: number) => Math.min(refreshIntervalMs, 60 * 1000 * 2 ** Math.min(failureCount - 1, 30));
+
+/** After a crawl with errors the next one waits only for the backoff, after a complete one for the refresh interval. */
+export const isDue = (state: FeedState, now: number, refreshIntervalMs: number) => now >= state.nextAttemptAt && (state.failureCount > 0 || state.lastSuccessAt === null || now - state.lastSuccessAt >= refreshIntervalMs);
+
+/**
+ * Records the end of a crawl. A crawl that read nothing is a complete failure and keeps the old freshness; a crawl with
+ * results but with errors, `progressed` when it stored confirmed batches before it was stopped, moves the freshness and
+ * comes back after the backoff instead of the refresh interval, so its failed parts are read again soon.
+ */
+export const finishCrawl = (state: FeedState, outcome: CrawlOutcome, seen: ReadonlySet<string>, now: number, refreshIntervalMs: number, progressed = false): FeedState => {
+    const failureCount = state.failureCount + 1;
+    if (outcome.succeeded === 0 && !progressed) {
+        return { ...state, lastStatus: 'failed', failureCount, nextAttemptAt: now + retryDelay(failureCount, refreshIntervalMs) };
+    }
+    const complete = outcome.succeeded > 0 && outcome.failed.length === 0 && outcome.warnings.length === 0;
+    const kept = new Set([...seen, ...state.entries.map((entry) => entry.snapshot.releaseId)]);
+    return {
+        ...state,
+        tracks: complete ? Object.fromEntries(Object.entries(state.tracks).filter(([id]) => kept.has(id))) : state.tracks,
+        lastSuccessAt: now,
+        lastStatus: complete ? 'complete' : 'partial',
+        failureCount: complete ? 0 : failureCount,
+        nextAttemptAt: complete ? 0 : now + retryDelay(failureCount, refreshIntervalMs),
+    };
+};
+
+const formatSize = (bytes: number) => {
+    const units = ['B', 'KiB', 'MiB', 'GiB', 'TiB'];
+    let value = bytes;
+    let unit = 0;
+    while (value >= 1024 && unit < units.length - 1) {
+        value /= 1024;
+        unit++;
+    }
+    return unit === 0 ? `${bytes} B` : `${value.toFixed(1)} ${units[unit]}`;
+};
+
+const isHttpsUrl = (value: string) => URL.canParse(value) && new URL(value).protocol === 'https:';
+
+/** `[updated] owner/repo name (tag) [pre-release] (repository description)`, the tag only when it differs. */
+export const entryTitle = (entry: FeedEntry) => {
+    const { snapshot } = entry;
+    const version = snapshot.name || snapshot.tagName;
+    const updated = entry.revision > 1 ? '[updated] ' : '';
+    const tag = version === snapshot.tagName ? '' : ` (${snapshot.tagName})`;
+    const prerelease = snapshot.isPrerelease ? ' [pre-release]' : '';
+    const description = snapshot.repositoryDescription ? ` (${snapshot.repositoryDescription})` : '';
+    return `${updated}${snapshot.repository} ${version}${tag}${prerelease}${description}`;
+};
+
+export const entryDescription = (snapshot: ReleaseSnapshot) => {
+    const assets = snapshot.assets.map((asset) => {
+        const label = `${escapeText(asset.name)} (${formatSize(asset.size)})`;
+        return isHttpsUrl(asset.downloadUrl) ? `<li><a href="${escapeAttribute(asset.downloadUrl)}">${label}</a></li>` : `<li>${label}</li>`;
+    });
+    const list = assets.length === 0 ? '<p>No assets.</p>' : `<ul>${assets.join('')}</ul>`;
+    return `${snapshot.descriptionHTML}<h3>Assets</h3>${list}`;
+};
+
+const toItem = (entry: FeedEntry): DataItem => ({
+    title: entryTitle(entry),
+    description: entryDescription(entry.snapshot),
+    link: entry.snapshot.url,
+    guid: entry.guid,
+    pubDate: entry.pubDate,
+    author: entry.snapshot.repository.split('/', 1)[0],
+    category: [entry.snapshot.repository, entry.snapshot.isPrerelease ? 'pre-release' : 'stable'],
+});
+
+const feedLink = (params: CrawlParams) => {
+    if (params.targets.length !== 1) {
+        return 'https://github.com';
+    }
+    return params.mode === 'repo' ? `https://github.com/${params.targets[0]}/releases` : `https://github.com/${params.targets[0]}`;
+};
+
+const progressText = (state: FeedState, running: boolean) => {
+    if (!running) {
+        return '';
+    }
+    if (state.entries.length > 0) {
+        return 'A crawl of GitHub releases is in progress, more entries may follow. ';
+    }
+    return state.lastStatus === 'never' ? 'Preparing the feed: the first crawl of GitHub releases is still running. ' : 'An update of GitHub releases is in progress, there are no entries yet. ';
+};
+
+const resultText = (state: FeedState, running: boolean, count: number) => {
+    if (state.lastStatus === 'partial' || state.lastStatus === 'failed') {
+        return ' The last crawl had errors, see the server log.';
+    }
+    return !running && count === 0 && state.lastSuccessAt !== null ? ' No releases match the filters.' : '';
+};
+
+/** The current snapshot; an empty feed is valid while a crawl runs or when nothing matches, not after a complete failure. */
+export const renderFeed = (params: CrawlParams, state: FeedState, running: boolean): Data => {
+    if (state.entries.length === 0 && !running && state.lastStatus === 'failed') {
+        throw new Error('The GitHub releases crawl failed and there is no stored feed yet, see the server log');
+    }
+    const lastUpdate = state.lastSuccessAt === null ? 'never' : new Date(state.lastSuccessAt).toISOString();
+    return {
+        title: `GitHub releases of ${params.targets.join(', ')}`,
+        link: feedLink(params),
+        description: `${progressText(state, running)}Last completed update: ${lastUpdate}.${resultText(state, running, state.entries.length)}`,
+        item: state.entries.map((entry) => toItem(entry)),
+        allowEmpty: true,
+    };
+};
