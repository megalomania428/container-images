diff -ruN -x .git a/test/http-session.test.mjs b/test/http-session.test.mjs
--- a/test/http-session.test.mjs	1970-01-01 00:00:00.000000000 +0000
+++ b/test/http-session.test.mjs	2026-11-04 16:11:03.362894988 +0000
@@ -0,0 +1,188 @@
+/**
+ * Regression tests for HTTP session termination
+ * Run after the build: node --test test/http-session.test.mjs
+ * MCP_SERVER_ENTRY overrides the server entry point (default: build/index.js)
+ */
+
+import { test, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { spawn } from 'node:child_process';
+import { createServer } from 'node:http';
+import { fileURLToPath } from 'node:url';
+
+const entry =
+  process.env.MCP_SERVER_ENTRY || fileURLToPath(new URL('../build/index.js', import.meta.url));
+
+let stub;
+let child;
+let baseUrl;
+
+/**
+ * Listen on a random local port and return it
+ */
+function listen(server) {
+  return new Promise((resolve, reject) => {
+    server.once('error', reject);
+    server.listen(0, '127.0.0.1', () => resolve(server.address().port));
+  });
+}
+
+/**
+ * Find a free local port
+ */
+async function freePort() {
+  const server = createServer();
+  const port = await listen(server);
+  await new Promise((resolve) => server.close(resolve));
+  return port;
+}
+
+/**
+ * Wait until the MCP server answers the health check
+ */
+async function waitForHealth() {
+  const deadline = Date.now() + 10000;
+  while (Date.now() < deadline) {
+    try {
+      const response = await fetch(`${baseUrl}/health`, {
+        signal: AbortSignal.timeout(Math.max(deadline - Date.now(), 1)),
+      });
+      if (response.ok) {
+        return;
+      }
+    } catch {
+      // Server is not listening yet or the request timed out
+    }
+    await new Promise((resolve) => setTimeout(resolve, 100));
+  }
+  throw new Error('MCP server did not become healthy within 10 s');
+}
+
+/**
+ * Send a request to the MCP endpoint and parse JSON or SSE messages
+ */
+async function send(method, sessionId, body, headers = {}) {
+  const response = await fetch(`${baseUrl}/mcp`, {
+    method,
+    headers: {
+      'Content-Type': 'application/json',
+      Accept: 'application/json, text/event-stream',
+      ...(sessionId ? { 'mcp-session-id': sessionId } : {}),
+      ...headers,
+    },
+    body: body === undefined ? undefined : JSON.stringify(body),
+    signal: AbortSignal.timeout(10000),
+  });
+  const text = await response.text();
+  const type = response.headers.get('content-type') || '';
+  let messages = [];
+  if (type.includes('text/event-stream')) {
+    messages = text
+      .split('\n')
+      .filter((line) => line.startsWith('data:'))
+      .map((line) => JSON.parse(line.slice(5)));
+  } else if (type.includes('application/json') && text) {
+    messages = [JSON.parse(text)];
+  }
+  return { status: response.status, headers: response.headers, messages };
+}
+
+/**
+ * Open a new MCP session and return its ID
+ */
+async function openSession() {
+  const init = await send('POST', undefined, {
+    jsonrpc: '2.0',
+    id: 1,
+    method: 'initialize',
+    params: {
+      protocolVersion: '2025-03-26',
+      capabilities: {},
+      clientInfo: { name: 'http-session-test', version: '1.0.0' },
+    },
+  });
+  assert.equal(init.status, 200);
+  const sessionId = init.headers.get('mcp-session-id');
+  assert.ok(sessionId, 'initialize must return mcp-session-id');
+  const initialized = await send('POST', sessionId, {
+    jsonrpc: '2.0',
+    method: 'notifications/initialized',
+  });
+  assert.equal(initialized.status, 202);
+  return sessionId;
+}
+
+/**
+ * Request the tool list in a session
+ */
+function listTools(sessionId, id) {
+  return send('POST', sessionId, { jsonrpc: '2.0', id, method: 'tools/list' });
+}
+
+/**
+ * Assert that the session is alive and answers tools/list
+ */
+async function assertAlive(sessionId, id) {
+  const response = await listTools(sessionId, id);
+  assert.equal(response.status, 200);
+  const message = response.messages.find((m) => m.id === id);
+  assert.ok(message, `tools/list response with id ${id} expected`);
+  assert.deepEqual(
+    message.result.tools.map((tool) => tool.name),
+    ['search']
+  );
+}
+
+before(async () => {
+  stub = createServer((req, res) => {
+    res.writeHead(200, { 'Content-Type': 'application/json' });
+    res.end(req.method === 'HEAD' ? undefined : '{"results":[],"number_of_results":0}');
+  });
+  const stubPort = await listen(stub);
+  const port = await freePort();
+  baseUrl = `http://127.0.0.1:${port}`;
+  child = spawn(
+    process.execPath,
+    [entry, '--transport=http', '--host=127.0.0.1', `--port=${port}`],
+    {
+      env: { ...process.env, SEARXNG_URL: `http://127.0.0.1:${stubPort}` },
+      stdio: 'ignore',
+    }
+  );
+  await waitForHealth();
+});
+
+after(async () => {
+  child?.kill('SIGKILL');
+  await new Promise((resolve) => stub.close(resolve));
+});
+
+test('DELETE rejected by the SDK keeps the session alive', async () => {
+  const sessionId = await openSession();
+  const rejected = await send('DELETE', sessionId, undefined, {
+    'mcp-protocol-version': '1999-01-01',
+  });
+  assert.equal(rejected.status, 400);
+  await assertAlive(sessionId, 2);
+  const deleted = await send('DELETE', sessionId, undefined);
+  assert.equal(deleted.status, 200);
+  const afterDelete = await listTools(sessionId, 3);
+  assert.equal(afterDelete.status, 400);
+});
+
+test('DELETE closes only its own session', async () => {
+  const kept = await openSession();
+  const closed = await openSession();
+  const deleted = await send('DELETE', closed, undefined);
+  assert.equal(deleted.status, 200);
+  const afterDelete = await listTools(closed, 2);
+  assert.equal(afterDelete.status, 400);
+  await assertAlive(kept, 3);
+});
+
+test('DELETE of an unknown session is rejected and does not affect others', async () => {
+  const kept = await openSession();
+  const unknown = await send('DELETE', '00000000-0000-0000-0000-000000000000', undefined);
+  assert.equal(unknown.status, 400);
+  await assertAlive(kept, 2);
+});
