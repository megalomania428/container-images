diff -ruN -x .git a/src/utils/semaphore.ts b/src/utils/semaphore.ts
--- a/src/utils/semaphore.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/utils/semaphore.ts	2026-11-04 09:11:06.444894025 +0000
@@ -0,0 +1,88 @@
+/**
+ * Counting semaphore limiting the number of concurrently running operations
+ * Waiters are served in FIFO order; waiting can be cancelled with AbortSignal
+ */
+
+/**
+ * Releases an acquired slot; calling it more than once has no effect
+ */
+export type Release = () => void;
+
+interface Waiter {
+  resolve: (release: Release) => void;
+  reject: (reason: unknown) => void;
+  signal?: AbortSignal;
+  onAbort?: () => void;
+}
+
+export class Semaphore {
+  private available: number;
+  private waiters: Waiter[] = [];
+
+  constructor(limit: number) {
+    // Huge limits are allowed: they are not exact integers, but behave as unlimited
+    if (!(limit >= 1) || (Number.isFinite(limit) && !Number.isInteger(limit))) {
+      throw new Error(`Semaphore limit must be a positive integer, got: ${limit}`);
+    }
+    this.available = limit;
+  }
+
+  /**
+   * Wait for a free slot. The returned function releases the slot and must be
+   * called exactly when the operation stops occupying it, for example in finally
+   * or before a pause between attempts. If the signal is aborted while waiting,
+   * the waiter leaves the queue and the promise rejects with the signal reason.
+   */
+  acquire(signal?: AbortSignal): Promise<Release> {
+    if (signal?.aborted) {
+      return Promise.reject(signal.reason);
+    }
+    if (this.available > 0) {
+      this.available--;
+      return Promise.resolve(this.createRelease());
+    }
+    return new Promise<Release>((resolve, reject) => {
+      const waiter: Waiter = { resolve, reject, signal };
+      if (signal) {
+        waiter.onAbort = () => {
+          const index = this.waiters.indexOf(waiter);
+          if (index !== -1) {
+            this.waiters.splice(index, 1);
+          }
+          reject(signal.reason);
+        };
+        signal.addEventListener('abort', waiter.onAbort, { once: true });
+      }
+      this.waiters.push(waiter);
+    });
+  }
+
+  /**
+   * Create a one-shot release function for an acquired slot
+   */
+  private createRelease(): Release {
+    let released = false;
+    return () => {
+      if (released) {
+        return;
+      }
+      released = true;
+      this.handOver();
+    };
+  }
+
+  /**
+   * Pass a freed slot to the first waiter or return it to the pool
+   */
+  private handOver(): void {
+    const waiter = this.waiters.shift();
+    if (!waiter) {
+      this.available++;
+      return;
+    }
+    if (waiter.signal && waiter.onAbort) {
+      waiter.signal.removeEventListener('abort', waiter.onAbort);
+    }
+    waiter.resolve(this.createRelease());
+  }
+}
