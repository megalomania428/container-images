+test('an attempt cut short by the deadline keeps the previous result', async () => {
+  // The first attempt fails at once, the retry after 1 s hangs until the deadline
+  // before the headers or while reading the body
+  const queries = [
+    'reasons-then-hang',
+    'reasons-then-body-hang',
+    'bad-gateway-then-hang',
+    'bad-gateway-then-body-hang',
+    'drop-then-hang',
+  ];
+  const server = await startServer({
+    SEARXNG_CONCURRENCY: String(queries.length),
+    SEARXNG_DEADLINE_MS: '1500',
+    SEARXNG_ATTEMPT_TIMEOUT_MS: '5000',
+  });
+  try {
+    const { elapsed, isError, body } = await search(server, queries);
+    assert.ok(elapsed < 1500 + 1000, `call took ${elapsed} ms`);
+    assert.equal(isError, true);
+    for (const [i, query] of queries.entries()) {
+      assert.equal(requests.get(query).length, 2, `${query} must be retried once`);
+      assert.doesNotMatch(body.searches[i].error, /deadline/, `${query} lost the previous result`);
+    }
+    const [reasons, reasonsBody, badGateway, badGatewayBody, drop] = body.searches;
+    for (const result of [reasons, reasonsBody]) {
+      assert.equal(result.error, 'no results: google – timeout');
+      assert.deepEqual(result.unresponsive_engines, [
+        { engine: 'google', reason: 'timeout', suspended: false },
+      ]);
+    }
+    assert.match(badGateway.error, /HTTP 502: Bad Gateway — body: Bad Gateway/);
+    assert.match(badGatewayBody.error, /HTTP 502: Bad Gateway — body: Bad Gateway/);
+    assert.match(drop.error, /^Search failed for query "drop-then-hang": /);
+    for (const query of ['reasons-then-hang', 'reasons-then-body-hang']) {
+      const warned = (line) =>
+        line.startsWith('[WARN] ') &&
+        line.includes('SearXNG returned no results') &&
+        line.includes(`"query":"${query}","attempts":2,`);
+      for (let i = 0; i < 50 && !server.logs.some(warned); i++) {
+        await new Promise((resolve) => setTimeout(resolve, 20));
+      }
+      const message = `the final empty answer of ${query} must be logged with 2 attempts`;
+      assert.ok(server.logs.some(warned), message);
+    }
+  } finally {
+    server.child.kill();
+  }
+});
