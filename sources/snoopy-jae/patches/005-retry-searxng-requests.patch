+/**
+ * Check that a query failed once while reading the body of an HTTP error,
+ * waited at least minPause ms between the attempt starts, succeeded on the
+ * retry and was logged as an HTTP error
+ */
+async function assertBodyFailureRetried(query, status, minPause = 0) {
+  const { body } = await search(main, [query]);
+  assert.equal(body.searches[0].success, true);
+  const times = requests.get(query);
+  assert.equal(times.length, 2);
+  assert.ok(times[1] - times[0] >= minPause, `pause was ${times[1] - times[0]} ms`);
+  await waitHttpErrorLog(main, query, status);
+}
