+/**
+ * Regression tests for retries of SearXNG requests and their diagnostics
+ * Run after the build: node --test test/search-retry.test.mjs
+ * MCP_SERVER_ENTRY overrides the server entry point (default: build/index.js)
+ */
+
+import { test, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { spawn } from 'node:child_process';
+import { createServer } from 'node:http';
+import { createInterface } from 'node:readline';
+import { fileURLToPath } from 'node:url';
+
+const entry =
+  process.env.MCP_SERVER_ENTRY ||
+  fileURLToPath(new URL('../build/index.js', import.meta.url));
+const item = { url: 'https://example.com/', title: 'Example', content: 'Example page' };
+
+let stub;
+let stubUrl;
+let main;
+let starved;
+const requests = new Map();
+const seenHeaders = new Map();
+const held = [];
+
+/**
+ * Reply to the stub request with a SearXNG JSON body
+ */
+function reply(res, results, unresponsive = []) {
+  res.writeHead(200, { 'Content-Type': 'application/json' });
+  res.end(JSON.stringify({ query: 'q', results, unresponsive_engines: unresponsive }));
+}
+
+/**
+ * Send the headers and part of the body, then break the connection once the
+ * client had time to receive them
+ */
+function breakAfterWrite(req, res, chunk) {
+  res.write(chunk, () => setTimeout(() => req.socket.destroy(), 100));
+}
+
+/**
+ * Answer a stub request according to its query and the number of requests
+ * for that query seen so far
+ */
+function handle(req, res) {
+  if (req.method === 'HEAD') {
+    res.end();
+    return;
+  }
+  const query = new URL(req.url, 'http://stub').searchParams.get('q');
+  const times = requests.get(query) ?? [];
+  times.push(Date.now());
+  requests.set(query, times);
+  seenHeaders.set(query, req.headers);
+  const first = times.length === 1;
+  switch (query) {
+    case 'recover':
+      return first ? reply(res, [], [['google', 'timeout']]) : reply(res, [item]);
+    case 'persistent':
+      return reply(res, [], [['brave', 'Suspended: timeout'], ['google', 'HTTP error']]);
+    case 'honest':
+      return reply(res, []);
+    case 'long-ban':
+      return reply(res, [], [['bing', 'access denied'], ['google', 'Suspended: CAPTCHA']]);
+    case 'partial':
+      return reply(res, [item], [['bing', 'Suspended: too many requests']]);
+    case 'drop':
+      return first ? req.socket.destroy() : reply(res, [item]);
+    case 'slow':
+      if (first) {
+        setTimeout(() => res.destroyed || reply(res, [item]), 1000);
+        return;
+      }
+      return reply(res, [item]);
+    case 'bad-gateway':
+      if (first) {
+        res.writeHead(502);
+        res.end('Bad Gateway');
+        return;
+      }
+      return reply(res, [item]);
+    case 'retry-after':
+      if (first) {
+        res.writeHead(429, { 'Retry-After': '2' });
+        res.end('Too Many Requests');
+        return;
+      }
+      return reply(res, [item]);
+    case 'retry-after-far':
+      res.writeHead(429, { 'Retry-After': '60' });
+      res.end('Too Many Requests');
+      return;
+    case 'bad-request':
+      res.writeHead(400, { 'Content-Type': 'application/json' });
+      res.end('{"error": "No query"}');
+      return;
+    case 'bad-request-hang':
+      if (first) {
+        // Headers and part of the body arrive, the rest never does
+        res.writeHead(400, { 'Content-Type': 'application/json' });
+        res.write('{"error": ');
+        held.push(res);
+        return;
+      }
+      return reply(res, [item]);
+    case 'retry-after-hang':
+      if (first) {
+        // Retry-After arrives with the headers, the body never ends
+        res.writeHead(429, { 'Retry-After': '2' });
+        res.write('Too Many');
+        held.push(res);
+        return;
+      }
+      return reply(res, [item]);
+    case 'unavailable-drop':
+      if (first) {
+        res.writeHead(503, { 'Retry-After': '2' });
+        breakAfterWrite(req, res, 'Service');
+        return;
+      }
+      return reply(res, [item]);
+    case 'bad-request-drop':
+      if (first) {
+        // The connection breaks in the middle of the body
+        res.writeHead(400, { 'Content-Type': 'application/json' });
+        breakAfterWrite(req, res, '{"error": ');
+        return;
+      }
+      return reply(res, [item]);
+    case 'not-found-hang':
+      if (first) {
+        res.writeHead(404, { 'Content-Type': 'text/plain' });
+        res.write('Not');
+        held.push(res);
+        return;
+      }
+      return reply(res, [item]);
+    case 'hang':
+      held.push(res);
+      return;
+    case 'reasons-then-hang':
+      return first ? reply(res, [], [['google', 'timeout']]) : held.push(res);
+    case 'bad-gateway-then-hang':
+      if (first) {
+        res.writeHead(502);
+        res.end('Bad Gateway');
+        return;
+      }
+      held.push(res);
+      return;
+    case 'reasons-then-body-hang':
+      if (first) {
+        return reply(res, [], [['google', 'timeout']]);
+      }
+      // Headers of a good answer arrive, the body never ends
+      res.writeHead(200, { 'Content-Type': 'application/json' });
+      res.write('{"results": ');
+      held.push(res);
+      return;
+    case 'bad-gateway-then-body-hang':
+      res.writeHead(502);
+      if (first) {
+        res.end('Bad Gateway');
+        return;
+      }
+      res.write('Bad');
+      held.push(res);
+      return;
+    case 'drop-then-hang':
+      return first ? req.socket.destroy() : held.push(res);
+    default:
+      return reply(res, [item]);
+  }
+}
+
+/**
+ * Start the MCP server over stdio with the given environment and return a
+ * function sending JSON-RPC requests to it
+ */
+async function startServer(env) {
+  const child = spawn(process.execPath, [entry, '--transport=stdio'], {
+    env: { ...process.env, SEARXNG_URL: stubUrl, ...env },
+    stdio: ['pipe', 'pipe', 'pipe'],
+  });
+  const logs = [];
+  createInterface({ input: child.stderr }).on('line', (line) => logs.push(line));
+  const pending = new Map();
+  let nextId = 1;
+  createInterface({ input: child.stdout }).on('line', (line) => {
+    const message = JSON.parse(line);
+    pending.get(message.id)?.(message);
+    pending.delete(message.id);
+  });
+  const request = (method, params) => {
+    const id = nextId++;
+    return new Promise((resolve, reject) => {
+      const timer = setTimeout(() => {
+        pending.delete(id);
+        reject(new Error(`No response to ${method} within 10 s`));
+      }, 10000);
+      pending.set(id, (message) => {
+        clearTimeout(timer);
+        resolve(message);
+      });
+      child.stdin.write(`${JSON.stringify({ jsonrpc: '2.0', id, method, params })}\n`);
+    });
+  };
+  const init = await request('initialize', {
+    protocolVersion: '2025-03-26',
+    capabilities: {},
+    clientInfo: { name: 'search-retry-test', version: '1.0.0' },
+  });
+  assert.ok(init.result, 'initialize must succeed');
+  const initialized = { jsonrpc: '2.0', method: 'notifications/initialized' };
+  child.stdin.write(`${JSON.stringify(initialized)}\n`);
+  return { child, request, logs };
+}
+
+/**
+ * Wait until the server writes an ERROR line about an HTTP error of the
+ * query: stderr is a separate pipe and may lag behind the response
+ */
+async function waitHttpErrorLog(server, query, status) {
+  const matches = (line) =>
+    line.startsWith('[ERROR] ') &&
+    line.includes('HTTP error from SearXNG') &&
+    line.includes(`q=${query}&`) &&
+    line.includes(`"status":${status},`);
+  for (let i = 0; i < 50 && !server.logs.some(matches); i++) {
+    await new Promise((resolve) => setTimeout(resolve, 20));
+  }
+  assert.ok(server.logs.some(matches), `HTTP ${status} of ${query} must be logged as an error`);
+}
+
+/**
+ * Call the search tool and return the parsed result with the call duration
+ */
+async function search(server, queries) {
+  const started = Date.now();
+  const response = await server.request('tools/call', {
+    name: 'search',
+    arguments: { queries },
+  });
+  assert.equal(response.error, undefined, 'tool result expected, not a JSON-RPC error');
+  return {
+    elapsed: Date.now() - started,
+    isError: response.result.isError === true,
+    body: JSON.parse(response.result.content[0].text),
+  };
+}
