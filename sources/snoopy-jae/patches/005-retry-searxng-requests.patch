+  await new Promise((resolve, reject) => {
+    stub.once('error', reject);
+    stub.listen(0, '127.0.0.1', resolve);
+  });
+  stubUrl = `http://127.0.0.1:${stub.address().port}`;
+  main = await startServer({ SEARXNG_DEADLINE_MS: '3500', SEARXNG_ATTEMPT_TIMEOUT_MS: '500' });
+  starved = await startServer({
+    SEARXNG_CONCURRENCY: '1',
+    SEARXNG_DEADLINE_MS: '1000',
+    SEARXNG_ATTEMPT_TIMEOUT_MS: '5000',
+  });
+});
