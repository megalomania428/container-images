diff -ruN -x .git a/src/services/searxng-catalog.ts b/src/services/searxng-catalog.ts
--- a/src/services/searxng-catalog.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/services/searxng-catalog.ts	2026-11-05 19:40:02.716965009 +0000
@@ -0,0 +1,348 @@
+/**
+ * Catalog of SearXNG engines and categories from the /config endpoint
+ * SearXNG silently drops unknown engine and category names, so the names of
+ * a search call are checked and normalized against the catalog beforehand
+ */
+
+import { Logger } from '../utils/logger.js';
+
+/**
+ * Engine entry of the /config response
+ */
+interface CatalogEngine {
+  name: string;
+  /** Shortcut of the engine, NO_SHORTCUT when it has none */
+  shortcut: string;
+  /** Whether the engine is enabled by default; disabled ones still search when named */
+  enabled: boolean;
+}
+
+/**
+ * Engines and categories of the SearXNG instance
+ */
+interface Catalog {
+  engines: CatalogEngine[];
+  categories: string[];
+  /** Time of the load, in milliseconds since the epoch */
+  loadedAt: number;
+}
+
+/**
+ * Names of one kind resolved against the catalog
+ */
+interface Resolution {
+  /** Canonical names in the order of the call, without duplicates */
+  names: string[];
+  /** Quoted names that match nothing or more than one entry */
+  unknown: string[];
+}
+
+/**
+ * Engine and category names checked against the catalog; a kind absent from
+ * the call stays absent
+ */
+export interface ResolvedNames {
+  engines?: string[];
+  categories?: string[];
+}
+
+/** Shortcut SearXNG reports for an engine without one */
+const NO_SHORTCUT = "-";
+
+/**
+ * A search call refused before any request because of unknown engine or
+ * category names; the message is the text of the tool result
+ */
+export class SearchRejectedError extends Error {
+  readonly unknownEngines: string[];
+  readonly unknownCategories: string[];
+
+  constructor(message: string, unknownEngines: string[], unknownCategories: string[]) {
+    super(message);
+    this.name = "SearchRejectedError";
+    this.unknownEngines = unknownEngines;
+    this.unknownCategories = unknownCategories;
+  }
+}
+
+/**
+ * Parse the /config response, skipping malformed engine entries; a response
+ * without the engines or categories array is invalid
+ */
+function parseCatalog(data: unknown): Catalog {
+  const config = data as { engines?: unknown; categories?: unknown } | null;
+  if (
+    !config ||
+    typeof config !== "object" ||
+    !Array.isArray(config.engines) ||
+    !Array.isArray(config.categories)
+  ) {
+    throw new Error("invalid response: engines or categories is not an array");
+  }
+  const engines: CatalogEngine[] = [];
+  for (const entry of config.engines) {
+    const engine = entry as { name?: unknown; shortcut?: unknown; enabled?: unknown } | null;
+    if (!engine || typeof engine !== "object" || typeof engine.name !== "string") {
+      continue;
+    }
+    engines.push({
+      name: engine.name,
+      shortcut: typeof engine.shortcut === "string" ? engine.shortcut : NO_SHORTCUT,
+      enabled: engine.enabled !== false,
+    });
+  }
+  const categories = config.categories.filter(
+    (category): category is string => typeof category === "string"
+  );
+  return { engines, categories, loadedAt: Date.now() };
+}
+
+/**
+ * Find the entries matched by the first step that matches anything: the
+ * trimmed name exactly, ignoring case, with "-" and "_" read as spaces like
+ * SearXNG bangs, then a shortcut ignoring case; an empty name matches nothing
+ */
+function matchName(value: string, names: string[], shortcuts: Array<[string, string]>): string[] {
+  const trimmed = value.trim();
+  if (!trimmed) {
+    return [];
+  }
+  const lower = trimmed.toLowerCase();
+  const spaced = lower.replace(/[-_]/g, " ");
+  const steps = [
+    () => names.filter((name) => name === trimmed),
+    () => names.filter((name) => name.toLowerCase() === lower),
+    () => names.filter((name) => name.toLowerCase() === spaced),
+    () => shortcuts.filter(([shortcut]) => shortcut.toLowerCase() === lower).map(([, name]) => name),
+  ];
+  for (const step of steps) {
+    const found = step();
+    if (found.length) {
+      return found;
+    }
+  }
+  return [];
+}
+
+/**
+ * SearXNG catalog shared by all sessions of the process: loaded by the first
+ * call with names, reloaded after the TTL and when a name is unknown, at most
+ * once per refresh interval
+ */
+export class SearXNGCatalog {
+  private loadConfig: () => Promise<unknown>;
+  private ttl: number;
+  private refreshInterval: number;
+  private logger?: Logger;
+  /** Last loaded catalog, kept when a later load fails */
+  private catalog?: Catalog;
+  /** Load in flight, shared by every caller */
+  private loading?: Promise<void>;
+  /** Start of the last load, successful or not */
+  private lastAttemptAt?: number;
+
+  constructor(
+    loadConfig: () => Promise<unknown>,
+    ttl: number,
+    refreshInterval: number,
+    logger?: Logger
+  ) {
+    this.loadConfig = loadConfig;
+    this.ttl = ttl;
+    this.refreshInterval = refreshInterval;
+    this.logger = logger;
+  }
+
+  /**
+   * Check and normalize the names of a search call. Returns undefined when
+   * the call has no names or no catalog could be loaded, then the names go
+   * to SearXNG unchanged; throws SearchRejectedError on unknown names
+   */
+  async resolve(
+    engines: string[] | undefined,
+    categories: string[] | undefined,
+    deadlineSignal: AbortSignal
+  ): Promise<ResolvedNames | undefined> {
+    const engineNames = engines?.length ? engines : undefined;
+    const categoryNames = categories?.length ? categories : undefined;
+    if (!engineNames && !categoryNames) {
+      return undefined;
+    }
+    const expired = !this.isFresh();
+    if (expired) {
+      await this.refresh(deadlineSignal);
+    }
+    let resolved = this.match(engineNames, categoryNames);
+    // A name unknown to the catalog may belong to an engine added since then;
+    // a call reloads at most once, so a failed reload falls back to the old list
+    const unknown = resolved?.engines?.unknown.length || resolved?.categories?.unknown.length;
+    if (!expired && resolved && unknown) {
+      await this.refresh(deadlineSignal);
+      resolved = this.match(engineNames, categoryNames);
+    }
+    // A load cut short by the deadline decides nothing: the search then fails
+    // with the deadline instead of rejecting names by an outdated catalog
+    if (deadlineSignal.aborted) {
+      return undefined;
+    }
+    if (!this.catalog || !resolved) {
+      this.logger?.warn(`Searching without SearXNG name validation: /config is unavailable`, {
+        engines: engineNames,
+        categories: categoryNames,
+      });
+      return undefined;
+    }
+    if (resolved.engines?.unknown.length || resolved.categories?.unknown.length) {
+      throw this.rejection(this.catalog, resolved.engines, resolved.categories);
+    }
+    return {
+      ...(resolved.engines ? { engines: resolved.engines.names } : {}),
+      ...(resolved.categories ? { categories: resolved.categories.names } : {}),
+    };
+  }
+
+  /**
+   * Whether the catalog is loaded and younger than the TTL
+   */
+  private isFresh(): boolean {
+    return this.catalog !== undefined && Date.now() - this.catalog.loadedAt < this.ttl;
+  }
+
+  /**
+   * Join the load in flight or start a new one when the refresh interval
+   * allows it, then wait for it but not past the call deadline
+   */
+  private async refresh(deadlineSignal: AbortSignal): Promise<void> {
+    if (!this.loading) {
+      const allowed =
+        this.lastAttemptAt === undefined ||
+        Date.now() - this.lastAttemptAt >= this.refreshInterval;
+      if (!allowed) {
+        return;
+      }
+      this.loading = this.load();
+    }
+    const loading = this.loading;
+    await new Promise<void>((resolve) => {
+      if (deadlineSignal.aborted) {
+        resolve();
+        return;
+      }
+      const onAbort = () => resolve();
+      deadlineSignal.addEventListener("abort", onAbort, { once: true });
+      void loading.then(() => {
+        deadlineSignal.removeEventListener("abort", onAbort);
+        resolve();
+      });
+    });
+  }
+
+  /**
+   * Load the catalog once; never rejects, a failure keeps the previous
+   * catalog and is logged as a warning
+   */
+  private async load(): Promise<void> {
+    this.lastAttemptAt = Date.now();
+    try {
+      this.catalog = parseCatalog(await this.loadConfig());
+      this.logger?.debug(`Loaded SearXNG /config`, {
+        engines: this.catalog.engines.length,
+        categories: this.catalog.categories.length,
+      });
+    } catch (error) {
+      this.logger?.warn(`Failed to load SearXNG /config`, {
+        reason: error instanceof Error ? error.message : String(error),
+      });
+    } finally {
+      this.loading = undefined;
+    }
+  }
+
+  /**
+   * Resolve the names of the call against the current catalog, undefined
+   * without a catalog
+   */
+  private match(
+    engines: string[] | undefined,
+    categories: string[] | undefined
+  ): { engines?: Resolution; categories?: Resolution } | undefined {
+    if (!this.catalog) {
+      return undefined;
+    }
+    const engineNames = this.catalog.engines.map((engine) => engine.name);
+    const shortcuts = this.catalog.engines
+      .filter((engine) => engine.shortcut && engine.shortcut !== NO_SHORTCUT)
+      .map((engine): [string, string] => [engine.shortcut, engine.name]);
+    return {
+      ...(engines ? { engines: this.resolveNames("engine", engines, engineNames, shortcuts) } : {}),
+      ...(categories
+        ? { categories: this.resolveNames("category", categories, this.catalog.categories, []) }
+        : {}),
+    };
+  }
+
+  /**
+   * Resolve names of one kind, logging every name changed by normalization
+   */
+  private resolveNames(
+    kind: string,
+    values: string[],
+    names: string[],
+    shortcuts: Array<[string, string]>
+  ): Resolution {
+    const resolution: Resolution = { names: [], unknown: [] };
+    for (const value of values) {
+      const found = matchName(value, names, shortcuts);
+      if (found.length === 1) {
+        if (found[0] !== value) {
+          this.logger?.debug(`Normalized SearXNG ${kind} name`, { from: value, to: found[0] });
+        }
+        if (!resolution.names.includes(found[0])) {
+          resolution.names.push(found[0]);
+        }
+        continue;
+      }
+      const quoted =
+        found.length > 1
+          ? `${JSON.stringify(value)} (matches ${found.map((name) => JSON.stringify(name)).join(", ")})`
+          : JSON.stringify(value);
+      if (!resolution.unknown.includes(quoted)) {
+        resolution.unknown.push(quoted);
+      }
+    }
+    return resolution;
+  }
+
+  /**
+   * Build the error listing unknown names with the enabled engines and all
+   * categories of the instance
+   */
+  private rejection(
+    catalog: Catalog,
+    engines: Resolution | undefined,
+    categories: Resolution | undefined
+  ): SearchRejectedError {
+    const lines: string[] = [];
+    const unknownEngines = engines?.unknown ?? [];
+    const unknownCategories = categories?.unknown ?? [];
+    if (unknownEngines.length) {
+      const enabled = catalog.engines
+        .filter((engine) => engine.enabled)
+        .map((engine) => engine.name)
+        .sort();
+      const disabled = catalog.engines.length - enabled.length;
+      lines.push(`Unknown SearXNG engines: ${unknownEngines.join(", ")}.`);
+      lines.push(`Enabled engines: ${enabled.length ? enabled.join(", ") : "none"}.`);
+      if (disabled > 0) {
+        lines.push(`Engines disabled by default, accepted as well: ${disabled}.`);
+      }
+    }
+    if (unknownCategories.length) {
+      const all = [...catalog.categories].sort();
+      lines.push(`Unknown SearXNG categories: ${unknownCategories.join(", ")}.`);
+      lines.push(`Categories: ${all.length ? all.join(", ") : "none"}.`);
+    }
+    lines.push("No search was made.");
+    return new SearchRejectedError(lines.join("\n"), unknownEngines, unknownCategories);
+  }
+}
