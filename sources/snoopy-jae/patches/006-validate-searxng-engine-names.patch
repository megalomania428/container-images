+ * Run after the build: node --test test/engine-validation.test.mjs
+ * MCP_SERVER_ENTRY overrides the server entry point (default: build/index.js)
+ */
+
+import { test, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { spawn } from 'node:child_process';
+import { createServer } from 'node:http';
+import { createInterface } from 'node:readline';
+import { fileURLToPath } from 'node:url';
+
+const entry =
+  process.env.MCP_SERVER_ENTRY ||
+  fileURLToPath(new URL('../build/index.js', import.meta.url));
+const item = { url: 'https://example.com/', title: 'Example', content: 'Example page' };
+const catalog = {
+  categories: ['general', 'images', 'social media'],
+  engines: [
+    { name: 'google', shortcut: 'go', enabled: true },
+    { name: 'duckduckgo', shortcut: 'ddg', enabled: true },
+    { name: 'bing images', shortcut: 'bii', enabled: true },
+    { name: 'bing', shortcut: 'bi', enabled: false },
+    { name: 'wikipedia', shortcut: 'wp', enabled: true },
+    { name: 'alpha', shortcut: 'qq', enabled: true },
+    { name: 'beta', shortcut: 'QQ', enabled: true },
+    { name: 'go', shortcut: '-', enabled: true },
+  ],
+};
+const enabledList =
+  'Enabled engines: alpha, beta, bing images, duckduckgo, go, google, wikipedia.';
+const started = [];
+
+/**
+ * Wait the given number of milliseconds
+ */
+function sleep(ms) {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+/**
+ * Start a SearXNG stub and an MCP server over stdio using it. The stub
+ * answers /config with `stub.catalog` according to `stub.mode` (ok, error,
+ * invalid, slow, hang) and counts these requests; /search records engines
+ * and categories by query. `searxngUrl` builds SEARXNG_URL from the port
+ */
+async function setup(env = {}, searxngUrl = (port) => `http://127.0.0.1:${port}`) {
+  const stub = {
+    mode: 'ok',
+    catalog: structuredClone(catalog),
+    configRequests: 0,
+    searches: new Map(),
+  };
+  const http = createServer((req, res) => {
+    if (req.method === 'HEAD') {
+      res.end();
+      return;
+    }
+    const url = new URL(req.url, 'http://stub');
+    if (url.pathname === '/config') {
+      stub.configRequests++;
+      if (stub.mode === 'error') {
+        res.writeHead(500);
+        res.end('boom');
+        return;
+      }
+      if (stub.mode === 'hang') {
+        return;
+      }
+      res.writeHead(200, { 'Content-Type': 'application/json' });
+      if (stub.mode === 'invalid') {
+        res.end('{not json');
+        return;
+      }
+      const delay = stub.mode === 'slow' ? 300 : 0;
+      const body = JSON.stringify(stub.catalog);
+      setTimeout(() => res.end(body), delay);
+      return;
+    }
+    stub.searches.set(url.searchParams.get('q'), {
+      engines: url.searchParams.get('engines'),
+      categories: url.searchParams.get('categories'),
+    });
+    res.writeHead(200, { 'Content-Type': 'application/json' });
+    res.end(JSON.stringify({ query: 'q', results: [item], unresponsive_engines: [] }));
+  });
+  await new Promise((resolve, reject) => {
+    http.once('error', reject);
+    http.listen(0, '127.0.0.1', resolve);
+  });
+  const child = spawn(process.execPath, [entry, '--transport=stdio'], {
+    env: {
+      ...process.env,
+      SEARXNG_URL: searxngUrl(http.address().port),
+      ...env,
+    },
+    stdio: ['pipe', 'pipe', 'pipe'],
+  });
+  started.push({ http, child });
+  const logs = [];
+  createInterface({ input: child.stderr }).on('line', (line) => logs.push(line));
+  const pending = new Map();
+  let nextId = 1;
+  createInterface({ input: child.stdout }).on('line', (line) => {
+    const message = JSON.parse(line);
+    pending.get(message.id)?.(message);
+    pending.delete(message.id);
+  });
+  const request = (method, params) => {
+    const id = nextId++;
+    return new Promise((resolve, reject) => {
+      const timer = setTimeout(() => {
+        pending.delete(id);
+        reject(new Error(`No response to ${method} within 10 s`));
+      }, 10000);
+      pending.set(id, (message) => {
+        clearTimeout(timer);
+        resolve(message);
+      });
+      child.stdin.write(`${JSON.stringify({ jsonrpc: '2.0', id, method, params })}\n`);
+    });
+  };
+  const init = await request('initialize', {
+    protocolVersion: '2025-03-26',
+    capabilities: {},
+    clientInfo: { name: 'engine-validation-test', version: '1.0.0' },
+  });
+  assert.ok(init.result, 'initialize must succeed');
+  const initialized = { jsonrpc: '2.0', method: 'notifications/initialized' };
+  child.stdin.write(`${JSON.stringify(initialized)}\n`);
+  return { stub, request, logs };
+}
+
+/**
+ * Call the search tool with one query and the given filters
+ */
+async function search(server, query, filters = {}) {
+  const response = await server.request('tools/call', {
+    name: 'search',
+    arguments: { queries: [query], ...filters },
+  });
+  assert.equal(response.error, undefined, 'tool result expected, not a JSON-RPC error');
+  return { isError: response.result.isError === true, text: response.result.content[0].text };
+}
+
+/**
+ * Check that the call failed before any request to /search
+ */
+async function assertRejected(server, query, filters, ...lines) {
+  const { isError, text } = await search(server, query, filters);
+  assert.equal(isError, true, text);
+  for (const line of lines) {
+    assert.ok(text.split('\n').includes(line), `line "${line}" expected in:\n${text}`);
+  }
+  assert.ok(text.endsWith('No search was made.'), text);
+  assert.equal(server.stub.searches.has(query), false, 'no search request expected');
+}
+
+/**
+ * Check that the call searched and return the filters SearXNG received
+ */
+async function assertSearched(server, query, filters) {
+  const { isError, text } = await search(server, query, filters);
+  assert.equal(isError, false, text);
+  assert.equal(JSON.parse(text).searches[0].success, true, text);
+  assert.ok(server.stub.searches.has(query), 'search request expected');
+  return server.stub.searches.get(query);
+}
+
+/**
+ * Count WARN lines containing the text, waiting for at least `count` of
+ * them: stderr is a separate pipe and may lag behind the response
+ */
+async function waitWarnings(server, text, count) {
+  const matching = () =>
+    server.logs.filter((line) => line.startsWith('[WARN] ') && line.includes(text)).length;
+  for (let i = 0; i < 50 && matching() < count; i++) {
+    await sleep(20);
+  }
+  return matching();
+}
+
+after(async () => {
+  for (const { http, child } of started) {
+    child.kill();
+    http.closeAllConnections();
+    await new Promise((resolve) => http.close(resolve));
+  }
+});
+
+test('names are checked once per TTL and normalized', async (t) => {
+  const server = await setup();
+
+  await t.test('a call without filters does not load /config', async () => {
+    await assertSearched(server, 'plain');
+    assert.equal(server.stub.configRequests, 0);
+  });
+
+  await t.test('an unknown engine fails the call without a search', async () => {
+    await assertRejected(
+      server,
+      'unknown',
+      { engines: ['no_such_engine'] },
+      'Unknown SearXNG engines: "no_such_engine".',
+      enabledList,
+      'Engines disabled by default, accepted as well: 1.'
+    );
+    assert.equal(server.stub.configRequests, 1, 'the refresh interval blocks a second load');
+  });
+
+  await t.test('a known and an unknown engine fail the call', async () => {
+    await assertRejected(
+      server,
+      'mixed',
+      { engines: ['wikipedia', 'no_such_engine'] },
+      'Unknown SearXNG engines: "no_such_engine".'
+    );
+  });
+
+  await t.test('known engines, also disabled by default, are searched', async () => {
+    const sent = await assertSearched(server, 'known', { engines: ['wikipedia', 'bing'] });
+    assert.equal(sent.engines, 'wikipedia,bing');
+  });
+
+  await t.test('names are normalized and deduplicated', async () => {
+    const engines = [' Google ', 'DDG', 'bing_images', 'BING-IMAGES', 'google'];
+    const sent = await assertSearched(server, 'normalized', { engines });
+    assert.equal(sent.engines, 'google,duckduckgo,bing images');
+  });
+
+  await t.test('an engine name wins over a shortcut of another engine', async () => {
+    const sent = await assertSearched(server, 'name-first', { engines: ['GO', 'go'] });
+    assert.equal(sent.engines, 'go');
+  });
+
+  await t.test('an ambiguous, empty or "-" name fails the call', async () => {
+    await assertRejected(
+      server,
+      'ambiguous',
+      { engines: ['Qq', ' ', '-'] },
+      'Unknown SearXNG engines: "Qq" (matches "alpha", "beta"), " ", "-".'
+    );
+  });
+
+  await t.test('categories are checked and normalized', async () => {
+    const sent = await assertSearched(server, 'categories', {
+      categories: ['Social_Media', 'images', 'IMAGES'],
+    });
+    assert.equal(sent.categories, 'social media,images');
+    assert.equal(sent.engines, null);
+    await assertRejected(
+      server,
+      'bad-category',
+      { engines: ['nope'], categories: ['general', 'nothing'] },
+      'Unknown SearXNG engines: "nope".',
+      enabledList,
+      'Unknown SearXNG categories: "nothing".',
+      'Categories: general, images, social media.'
+    );
+  });
+
+  await t.test('the catalog stays cached within the TTL', async () => {
+    assert.equal(server.stub.configRequests, 1);
+  });
+});
+
+test('reloads follow the TTL and the refresh interval', async () => {
+  const server = await setup({
+    SEARXNG_ENGINES_TTL_MS: '2000',
+    SEARXNG_ENGINES_REFRESH_MS: '700',
+  });
+  await assertSearched(server, 'first', { engines: ['google'] });
+  assert.equal(server.stub.configRequests, 1);
+  server.stub.catalog.engines.push({ name: 'later', shortcut: '-', enabled: true });
+  await assertRejected(server, 'early', { engines: ['later'] });
+  assert.equal(server.stub.configRequests, 1, 'no reload within the refresh interval');
+  await sleep(800);
+  const sent = await assertSearched(server, 'added', { engines: ['later'] });
+  assert.equal(sent.engines, 'later', 'an unknown name reloads the catalog');
+  assert.equal(server.stub.configRequests, 2);
+  for (const query of ['typo-1', 'typo-2', 'typo-3']) {
+    await assertRejected(server, query, { engines: ['nope'] });
+  }
+  assert.equal(server.stub.configRequests, 2, 'one reload for a series of unknown names');
+  await assertSearched(server, 'cached', { engines: ['google'] });
+  assert.equal(server.stub.configRequests, 2);
+  await sleep(2100);
+  await assertSearched(server, 'expired', { engines: ['google'] });
+  assert.equal(server.stub.configRequests, 3, 'reload after the TTL');
+});
+
+test('a reload cut by the deadline fails the call with the deadline', async () => {
+  const server = await setup({ SEARXNG_ENGINES_REFRESH_MS: '300', SEARXNG_DEADLINE_MS: '1000' });
+  await assertSearched(server, 'before', { engines: ['google'] });
+  server.stub.catalog.engines.push({ name: 'later', shortcut: '-', enabled: true });
+  server.stub.mode = 'hang';
+  await sleep(400);
+  const { isError, text } = await search(server, 'cut', { engines: ['later'] });
+  assert.equal(isError, true, text);
+  assert.ok(text.includes('deadline of 1000 ms exceeded'), text);
+  assert.ok(!text.includes('Unknown SearXNG'), text);
+  assert.equal(server.stub.configRequests, 2);
+  assert.equal(server.stub.searches.has('cut'), false, 'no search request expected');
+});
+
+test('a call reloads an expired catalog at most once', async (t) => {
+  // A hanging reload times out quickly; a slow one (300 ms) has ample time to finish
+  const env = (mode) => ({
+    SEARXNG_ENGINES_TTL_MS: '300',
+    SEARXNG_ENGINES_REFRESH_MS: '100',
+    SEARXNG_ATTEMPT_TIMEOUT_MS: mode === 'slow' ? '1500' : '500',
+    SEARXNG_DEADLINE_MS: '3000',
+  });
+  // Names "later" exist only in the reloaded catalog: the old one rejects them
+  const engines = { engines: ['later', 'nope'] };
+  const categories = { categories: ['later', 'nothing'] };
+  const oldEngines = 'Unknown SearXNG engines: "later", "nope".';
+  const oldCategories = 'Unknown SearXNG categories: "later", "nothing".';
+  const cases = [
+    // The reload of the expired catalog times out, the old list rejects the names
+    ['a timed out reload', 'hang', engines, oldEngines],
+    ['a timed out reload', 'hang', categories, oldCategories],
+    // The reload outlasts the refresh interval, the new list rejects the name
+    ['a slow reload', 'slow', engines, 'Unknown SearXNG engines: "nope".'],
+    ['a slow reload', 'slow', categories, 'Unknown SearXNG categories: "nothing".'],
+  ];
+  for (const [name, mode, filters, line] of cases) {
+    await t.test(`${name} of ${Object.keys(filters)[0]}`, async () => {
+      const server = await setup(env(mode));
+      await assertSearched(server, 'fresh', { engines: ['google'] });
+      server.stub.catalog.engines.push({ name: 'later', shortcut: '-', enabled: true });
+      server.stub.catalog.categories.push('later');
+      server.stub.mode = mode;
+      await sleep(400);
+      await assertRejected(server, 'once', filters, line);
+      assert.equal(server.stub.configRequests, 2, 'no second reload for the unknown name');
+    });
+  }
+});
+
+test('concurrent calls share one load of /config', async () => {
+  const server = await setup();
+  server.stub.mode = 'slow';
+  // Every call waits for the load: names are normalized and unknown ones rejected
+  const queries = ['shared-1', 'shared-2', 'shared-3'];
+  const searched = queries.map((query) => assertSearched(server, query, { engines: ['DDG'] }));
+  const rejected = assertRejected(server, 'shared-unknown', { engines: ['no_such_engine'] });
+  for (const sent of await Promise.all(searched)) {
+    assert.equal(sent.engines, 'duckduckgo');
+  }
+  await rejected;
+  assert.equal(server.stub.configRequests, 1);
+});
+
+test('a failed reload keeps checking against the last catalog', async () => {
+  const server = await setup({ SEARXNG_ENGINES_TTL_MS: '300', SEARXNG_ENGINES_REFRESH_MS: '300' });
+  await assertSearched(server, 'loaded', { engines: ['google'] });
+  server.stub.mode = 'error';
+  await sleep(400);
+  await assertRejected(server, 'stale-unknown', { engines: ['no_such_engine'] });
+  assert.equal(server.stub.configRequests, 2, 'the expired catalog is reloaded');
+  assert.equal(await waitWarnings(server, 'Failed to load SearXNG /config', 1), 1);
+  const sent = await assertSearched(server, 'stale-known', { engines: ['Wikipedia'] });
+  assert.equal(sent.engines, 'wikipedia');
+});
+
+test('without a catalog the search runs unchecked with a warning', async () => {
+  const server = await setup({ SEARXNG_ENGINES_REFRESH_MS: '300' });
+  server.stub.mode = 'error';
+  const sent = await assertSearched(server, 'unchecked', { engines: ['no_such_engine'] });
+  assert.equal(sent.engines, 'no_such_engine');
+  assert.equal(await waitWarnings(server, 'Failed to load SearXNG /config', 1), 1);
+  assert.equal(await waitWarnings(server, 'Searching without SearXNG name validation', 1), 1);
+  server.stub.mode = 'invalid';
+  await sleep(400);
+  await assertSearched(server, 'invalid', { engines: ['no_such_engine'] });
+  assert.equal(server.stub.configRequests, 2);
+  assert.equal(await waitWarnings(server, 'Failed to load SearXNG /config', 2), 2);
+  assert.equal(await waitWarnings(server, 'Searching without SearXNG name validation', 2), 2);
+});
