+test('credentials in SEARXNG_URL stay out of the /config warning', async (t) => {
+  // The search itself fails on such URLs, the deadline keeps the call short
+  const cases = [
+    ['a valid URL', (port) => `http://user:secret@127.0.0.1:${port}`, 'URL: credentials belong'],
+    ['a URL broken by /config', (port) => `http://user:secret@127.0.0.1:${port} `, 'URL"'],
+  ];
+  for (const [name, searxngUrl, reason] of cases) {
+    await t.test(name, async () => {
+      const server = await setup({ SEARXNG_DEADLINE_MS: '1000' }, searxngUrl);
+      await search(server, 'credentials', { engines: ['google'] });
+      assert.equal(await waitWarnings(server, 'Failed to load SearXNG /config', 1), 1);
+      const warning = server.logs.find((line) => line.includes('Failed to load SearXNG /config'));
+      assert.ok(warning.includes(`invalid SearXNG ${reason}`), warning);
+      assert.ok(!warning.includes('secret'), warning);
+      assert.equal(server.stub.configRequests, 0);
+    });
+  }
+});
