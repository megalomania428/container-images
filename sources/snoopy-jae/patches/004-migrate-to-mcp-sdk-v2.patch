diff -ruN -x .git a/test/search-validation.test.mjs b/test/search-validation.test.mjs
--- a/test/search-validation.test.mjs	1970-01-01 00:00:00.000000000 +0000
+++ b/test/search-validation.test.mjs	2026-11-04 19:42:11.226697984 +0000
@@ -0,0 +1,109 @@
+/**
+ * Regression tests for search tool argument validation texts
+ * Run after the build: node --test test/search-validation.test.mjs
+ * MCP_SERVER_ENTRY overrides the server entry point (default: build/index.js)
+ */
+
+import { test, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { spawn } from 'node:child_process';
+import { createInterface } from 'node:readline';
+import { fileURLToPath } from 'node:url';
+
+const entry =
+  process.env.MCP_SERVER_ENTRY ||
+  fileURLToPath(new URL('../build/index.js', import.meta.url));
+const prefix = 'Input validation error: Invalid arguments for tool search: ';
+const queriesError = 'queries parameter is required and must be a non-empty array';
+
+let child;
+let nextId = 1;
+const pending = new Map();
+
+/**
+ * Send a JSON-RPC request over stdio and wait for its response
+ */
+function request(method, params) {
+  const id = nextId++;
+  return new Promise((resolve, reject) => {
+    const timer = setTimeout(() => {
+      pending.delete(id);
+      reject(new Error(`No response to ${method} within 10 s`));
+    }, 10000);
+    pending.set(id, (message) => {
+      clearTimeout(timer);
+      resolve(message);
+    });
+    child.stdin.write(`${JSON.stringify({ jsonrpc: '2.0', id, method, params })}\n`);
+  });
+}
+
+/**
+ * Call the search tool and return the text of its error result
+ */
+async function searchError(args) {
+  const response = await request('tools/call', { name: 'search', arguments: args });
+  assert.equal(response.error, undefined, 'tool result expected, not a JSON-RPC error');
+  assert.equal(response.result.isError, true);
+  assert.equal(response.result.content.length, 1);
+  return response.result.content[0].text;
+}
+
+/**
+ * Count occurrences of a substring
+ */
+function count(text, part) {
+  return text.split(part).length - 1;
+}
+
+before(async () => {
+  child = spawn(process.execPath, [entry, '--transport=stdio'], {
+    // Validation fails before any SearXNG request, the URL is never reached
+    env: { ...process.env, SEARXNG_URL: 'http://127.0.0.1:9' },
+    stdio: ['pipe', 'pipe', 'ignore'],
+  });
+  createInterface({ input: child.stdout }).on('line', (line) => {
+    const message = JSON.parse(line);
+    pending.get(message.id)?.(message);
+    pending.delete(message.id);
+  });
+  const init = await request('initialize', {
+    protocolVersion: '2025-03-26',
+    capabilities: {},
+    clientInfo: { name: 'search-validation-test', version: '1.0.0' },
+  });
+  assert.ok(init.result, 'initialize must succeed');
+  const initialized = { jsonrpc: '2.0', method: 'notifications/initialized' };
+  child.stdin.write(`${JSON.stringify(initialized)}\n`);
+});
+
+after(() => {
+  child?.kill('SIGKILL');
+});
+
+test('empty string queries report the queries error once', async () => {
+  assert.equal(await searchError({ queries: '' }), `${prefix}queries: ${queriesError}`);
+});
+
+// A non-array value with a length below one must not trigger the length check
+for (const length of [0, -1, 0.5, null, false, '0', '', 'abc', [], {}]) {
+  const name = `non-array queries with length ${JSON.stringify(length)}`;
+  test(`${name} report the queries error once`, async () => {
+    const text = await searchError({ queries: { length } });
+    assert.equal(text, `${prefix}queries: ${queriesError}`);
+  });
+}
+
+test('empty string queries keep other argument errors', async () => {
+  const text = await searchError({ queries: '', safesearch: 3 });
+  assert.equal(
+    text,
+    `${prefix}queries: ${queriesError}, safesearch: safesearch must be between 0 and 2`
+  );
+  assert.equal(count(text, queriesError), 1);
+});
+
+test('empty and missing queries report the queries error once', async () => {
+  assert.equal(await searchError({ queries: [] }), `${prefix}queries: ${queriesError}`);
+  assert.equal(await searchError({}), `${prefix}queries: ${queriesError}`);
+});
diff -ruN -x .git a/test/tool-call-logging.test.mjs b/test/tool-call-logging.test.mjs
--- a/test/tool-call-logging.test.mjs	1970-01-01 00:00:00.000000000 +0000
+++ b/test/tool-call-logging.test.mjs	2026-11-04 19:42:11.226697984 +0000
@@ -0,0 +1,205 @@
+/**
+ * Regression tests for logging of search tool calls
+ * Run after the build: node --test test/tool-call-logging.test.mjs
+ * MCP_SERVER_ENTRY overrides the server entry point (default: build/index.js)
+ */
+
+import { test, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { spawn } from 'node:child_process';
+import { createInterface } from 'node:readline';
+import { fileURLToPath } from 'node:url';
+
+const entry =
+  process.env.MCP_SERVER_ENTRY ||
+  fileURLToPath(new URL('../build/index.js', import.meta.url));
+const executing = /^\[INFO\] \S+ - Executing tool: search(?: (.*))?$/;
+const failed = /^\[ERROR\] \S+ - Tool execution failed: search(?: (.*))?$/;
+const queriesError = 'queries parameter is required and must be a non-empty array';
+
+let child;
+let nextId = 1;
+let logs = [];
+const pending = new Map();
+
+/**
+ * Send a JSON-RPC request over stdio and wait for its response
+ */
+function request(method, params) {
+  const id = nextId++;
+  return new Promise((resolve, reject) => {
+    const timer = setTimeout(() => {
+      pending.delete(id);
+      reject(new Error(`No response to ${method} within 10 s`));
+    }, 10000);
+    pending.set(id, (message) => {
+      clearTimeout(timer);
+      resolve(message);
+    });
+    child.stdin.write(`${JSON.stringify({ jsonrpc: '2.0', id, method, params })}\n`);
+  });
+}
+
+/**
+ * Collect the log lines of the call written so far
+ */
+function collect() {
+  return {
+    executing: logs.map((line) => line.match(executing)).filter(Boolean),
+    failed: logs.map((line) => line.match(failed)).filter(Boolean),
+  };
+}
+
+/**
+ * Call the search tool and return the log lines written for the call once
+ * the expected ones arrived: stderr is a separate pipe and may lag behind
+ * the response
+ */
+async function callLogs(params, expectFailed) {
+  logs = [];
+  const response = await request('tools/call', { name: 'search', ...params });
+  assert.equal(response.error, undefined, 'tool result expected, not a JSON-RPC error');
+  assert.equal(response.result.isError, true);
+  const deadline = Date.now() + 5000;
+  for (;;) {
+    const result = collect();
+    if (result.executing.length > 0 && (!expectFailed || result.failed.length > 0)) break;
+    if (Date.now() > deadline) return result;
+    await new Promise((resolve) => setTimeout(resolve, 20));
+  }
+  // Extra lines would have been written together with the expected ones
+  await new Promise((resolve) => setTimeout(resolve, 100));
+  return collect();
+}
+
+/**
+ * Check that a call rejected by validation is logged once with its arguments
+ * and once as failed with the validation error text
+ */
+async function assertRejectedCall(params, loggedArgs, errorText) {
+  const result = await callLogs(params, true);
+  assert.equal(result.executing.length, 1, 'one Executing tool line expected');
+  assert.deepEqual(JSON.parse(result.executing[0][1]), loggedArgs);
+  assert.equal(result.failed.length, 1, 'one Tool execution failed line expected');
+  assert.ok(result.failed[0][1].includes(errorText), result.failed[0][1]);
+}
+
+before(async () => {
+  child = spawn(process.execPath, [entry, '--transport=stdio'], {
+    // Nothing listens on the discard port, every search query fails fast
+    env: { ...process.env, SEARXNG_URL: 'http://127.0.0.1:9' },
+    stdio: ['pipe', 'pipe', 'pipe'],
+  });
+  createInterface({ input: child.stdout }).on('line', (line) => {
+    const message = JSON.parse(line);
+    pending.get(message.id)?.(message);
+    pending.delete(message.id);
+  });
+  createInterface({ input: child.stderr }).on('line', (line) => {
+    logs.push(line);
+  });
+  const init = await request('initialize', {
+    protocolVersion: '2025-03-26',
+    capabilities: {},
+    clientInfo: { name: 'tool-call-logging-test', version: '1.0.0' },
+  });
+  assert.ok(init.result, 'initialize must succeed');
+  const initialized = { jsonrpc: '2.0', method: 'notifications/initialized' };
+  child.stdin.write(`${JSON.stringify(initialized)}\n`);
+});
+
+after(() => {
+  child?.kill();
+});
+
+test('a call without arguments is logged as failed', async () => {
+  await assertRejectedCall({}, {}, queriesError);
+});
+
+test('a call with empty queries is logged as failed', async () => {
+  await assertRejectedCall(
+    { arguments: { queries: [] } },
+    { queries: [] },
+    queriesError
+  );
+});
+
+test('a call with a blank query is logged as failed', async () => {
+  await assertRejectedCall(
+    { arguments: { queries: [' '] } },
+    { queries: [' '] },
+    'All queries must be non-empty strings'
+  );
+});
+
+test('a call with an out of range safesearch is logged as failed', async () => {
+  await assertRejectedCall(
+    { arguments: { queries: ['a'], safesearch: 3 } },
+    { queries: ['a'], safesearch: 3 },
+    'safesearch must be between 0 and 2'
+  );
+});
+
+test('a call with a wrong argument type is logged as failed', async () => {
+  await assertRejectedCall(
+    { arguments: { queries: ['a'], engines: 'x' } },
+    { queries: ['a'], engines: 'x' },
+    'expected array, received string'
+  );
+});
+
+test('a call with an unknown argument is logged as failed', async () => {
+  await assertRejectedCall(
+    { arguments: { queries: ['a'], foo: 1 } },
+    { queries: ['a'], foo: 1 },
+    'Unrecognized key'
+  );
+});
+
+test('a call with a null optional argument is logged as failed', async () => {
+  await assertRejectedCall(
+    { arguments: { queries: ['a'], engines: null } },
+    { queries: ['a'], engines: null },
+    'expected array, received null'
+  );
+});
+
+test('a call with a non-string query is logged as failed', async () => {
+  await assertRejectedCall(
+    { arguments: { queries: [1] } },
+    { queries: [1] },
+    'All queries must be non-empty strings'
+  );
+});
+
+test('a call with string queries is logged as failed', async () => {
+  await assertRejectedCall(
+    { arguments: { queries: 'x' } },
+    { queries: 'x' },
+    queriesError
+  );
+});
+
+test('a call with a string safesearch is logged as failed', async () => {
+  await assertRejectedCall(
+    { arguments: { queries: ['a'], safesearch: '1' } },
+    { queries: ['a'], safesearch: '1' },
+    'expected number, received string'
+  );
+});
+
+test('a call with a non-string language is logged as failed', async () => {
+  await assertRejectedCall(
+    { arguments: { queries: ['a'], language: 5 } },
+    { queries: ['a'], language: 5 },
+    'expected string, received number'
+  );
+});
+
+test('a valid call is logged as executing once and not as failed', async () => {
+  // Every query fails against the discard port: a tool result, not an exception
+  const result = await callLogs({ arguments: { queries: ['a'] } }, false);
+  assert.equal(result.executing.length, 1, 'one Executing tool line expected');
+  assert.deepEqual(JSON.parse(result.executing[0][1]), { queries: ['a'] });
+  assert.equal(result.failed.length, 0, 'no Tool execution failed line expected');
+});
