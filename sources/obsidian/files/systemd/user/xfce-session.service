# cspell:ignore startxfce xinitrc
[Unit]
Description=XFCE desktop session on display :99
Requires=dbus.socket
After=dbus.socket
BindsTo=graphical-session.target
Before=graphical-session.target
StartLimitIntervalSec=0
[Service]
# Xvfb is a system unit, so wait for its socket on restarts of this session
ExecStartPre=/bin/sh -c 'until [ -S /tmp/.X11-unix/X99 ]; do sleep 0.1; done'
ExecStart=/usr/bin/startxfce4
Restart=always
RestartSec=3
[Install]
WantedBy=default.target
